--- a/include/ninfer/ops/linear_topk.h
+++ b/include/ninfer/ops/linear_topk.h
@@ -77,4 +77,20 @@ void two_level_head_requantize(const Weight& q8_head, void* q4_codes, void* q4_s
 void two_level_head_rescore(const Tensor& hidden, const Weight& q8_head,
                             const Tensor& candidate_ids, Tensor& tokens, cudaStream_t stream);
 
+// Research: low-bit (3-bit G64) screen for the two-level head (NINFER_HEAD_SCREEN=3).
+struct LowBitScreen {
+    void* codes  = nullptr;  // 2-bit plane [248320, 1280]
+    void* high   = nullptr;  // high-bit plane [248320, 640]
+    void* scales = nullptr;  // FP16 [248320, 80]
+    void* keys   = nullptr;  // per-CTA top-8 keys, 16 columns
+    void* mid    = nullptr;  // per-chunk top-32 keys, 16 columns
+};
+struct LowBitScreenSizes {
+    std::size_t codes = 0, high = 0, scales = 0, keys = 0, mid = 0;
+};
+LowBitScreenSizes lowbit_screen_sizes();
+void lowbit_screen_build(const Weight& q8_head, const LowBitScreen& screen, cudaStream_t stream);
+void lowbit_screen_verify(const Tensor& hidden, const Weight& q8_head, const LowBitScreen& screen,
+                          Tensor& tokens, cudaStream_t stream);
+
 } // namespace ninfer::ops
