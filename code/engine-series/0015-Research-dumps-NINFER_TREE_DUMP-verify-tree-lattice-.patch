+// Research: NINFER_TREE_DUMP=FILE appends each row's lattice (see tools/patch_tree_dump.py).
+void research_tree_dump(const char* path, const Tensor& candidate_ids, const Tensor& anchors,
+                        const Tensor& extents, const Tensor& lookup_tokens, const Tensor& lookup_counts,
+                        const Tensor& lookup_log_probability, const Tensor& rope_positions,
+                        const Tensor& edges, std::int32_t steps, std::int32_t batch, cudaStream_t stream) {
+    cudaStreamCaptureStatus capture = cudaStreamCaptureStatusNone;
+    if (cudaStreamIsCapturing(stream, &capture) != cudaSuccess ||
+        capture != cudaStreamCaptureStatusNone) {
+        throw std::runtime_error("NINFER_TREE_DUMP requires --no-cuda-graph");
+    }
+    cudaStreamSynchronize(stream);
+    const auto fetch = [](const Tensor& t, std::size_t n, std::size_t bytes, std::vector<char>& out) {
+        out.assign(n * bytes, 0);
+        if (t.data != nullptr) { cudaMemcpy(out.data(), t.data, out.size(), cudaMemcpyDeviceToHost); }
+    };
+    std::vector<char> ids, anc, ext, ltok, lcnt, llp, rope, edg;
+    fetch(candidate_ids, static_cast<std::size_t>(16) * steps * batch, 4, ids);
+    fetch(anchors, batch, 4, anc);
+    fetch(extents, batch, 4, ext);
+    fetch(lookup_tokens, static_cast<std::size_t>(steps) * batch, 4, ltok);
+    fetch(lookup_counts, batch, 4, lcnt);
+    fetch(lookup_log_probability, batch, 4, llp);
+    fetch(rope_positions, static_cast<std::size_t>(steps + 1) * batch, 4, rope);
+    fetch(edges, static_cast<std::size_t>(256) * steps * batch, 4, edg);
+    std::FILE* f = std::fopen(path, "ab");
+    if (f == nullptr) { throw std::runtime_error("NINFER_TREE_DUMP: cannot open file"); }
+    for (std::int32_t b = 0; b < batch; ++b) {
+        const auto i32 = [](const std::vector<char>& v) { return reinterpret_cast<const std::int32_t*>(v.data()); };
+        const std::int32_t header[5] = {steps, i32(rope)[b * (steps + 1)], i32(anc)[b], i32(ext)[b],
+                                        i32(lcnt)[b]};
+        std::fwrite(header, 4, 5, f);
+        std::fwrite(llp.data() + 4 * b, 4, 1, f);
+        std::fwrite(ltok.data() + static_cast<std::size_t>(4) * steps * b, 4, steps, f);
+        std::fwrite(ids.data() + static_cast<std::size_t>(64) * steps * b, 4, 16 * steps, f);
+        std::fwrite(edg.data() + static_cast<std::size_t>(1024) * steps * b, 4, 256 * steps, f);
+    }
+    std::fclose(f);
+}
+
 } // namespace
 
 std::size_t candidate_selector_path_workspace_capacity_bytes(int min_steps, int max_steps,
@@ -188,6 +232,11 @@ void candidate_selector_tree(const Tensor& candidate_ids, const Tensor& unary_sc
         candidate_ids, unary_scores, projected_hidden, anchors, predecessor_codebook,
         successor_codebook, current_extents, lookup_tokens, lookup_counts, lookup_log_probability,
         drafts, tree_parents, tree_masks, rope_positions, scratch.edges, stream);
+    if (const char* path = std::getenv("NINFER_TREE_DUMP"); path != nullptr && *path != 0) {
+        research_tree_dump(path, candidate_ids, anchors, current_extents, lookup_tokens, lookup_counts,
+                           lookup_log_probability, rope_positions, scratch.edges, kSteps, batch_size,
+                           stream);
+    }
 }
 
 void candidate_selector_lookup_chain(const Tensor& current_extents, const Tensor& lookup_tokens,
