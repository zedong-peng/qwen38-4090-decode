+// Research (NINFER_Q3_TILED): bytes of w's stage-packed Q3 tiles (25 per 64-weight group).
+std::size_t q3_packed_bytes(const Weight& w);
+// Packs w's Q3 planes and LS8 bytes per (CTA, pipeline stage) of an Ada small-T schedule with rows_cta rows per CTA
+// and groups_per_stage groups per stage: tile (b, s) = [low chunks row-major | high chunks | LS8 bytes rows x G].
+// paired_offset > 0: CTA b's local rows [0, rows_cta / 2) are weight rows b * rows_cta / 2 + r and the rest
+// paired_offset + b * rows_cta / 2 + r - rows_cta / 2 (AdaPairedHalfRows); 0: contiguous rows.
+void q3_pack_tiles(const Weight& w, void* dst, int rows_cta, int groups_per_stage, int paired_offset,
+                   cudaStream_t stream);
 
 } // namespace ninfer::ops
