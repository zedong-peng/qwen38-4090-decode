index ac27827..3ff68c1 100644
--- a/src/ops/linear_topk/two_level_head.cu
+++ b/src/ops/linear_topk/two_level_head.cu
@@ -157,6 +157,38 @@ void require_q8_head(const Weight& head) {
 
