+// One CTA per (block, stage) tile; see q3_pack_tiles.
+__global__ void q3_pack_tiles_kernel(const std::uint8_t* __restrict__ low, const std::uint8_t* __restrict__ high,
+                                     const std::uint8_t* __restrict__ ls8, std::uint8_t* __restrict__ dst,
+                                     int stages, int rows_cta, int g, int groups, int paired) {
+    const std::int64_t tile = blockIdx.x;
+    const int stage         = static_cast<int>(tile % stages);
+    const std::int64_t b    = tile / stages;
+    const int low_chunks = g, high_chunks = g / 2, half = rows_cta / 2;
+    std::uint8_t* out = dst + tile * static_cast<std::int64_t>(rows_cta) * g * 25;
+    const auto row_of = [&](int r) -> std::int64_t {
+        return paired > 0 ? (r < half ? b * half + r : paired + b * half + r - half) : b * rows_cta + r;
+    };
+    for (int i = threadIdx.x; i < rows_cta * low_chunks; i += blockDim.x) {
+        const int r = i / low_chunks, c = i % low_chunks;
+        reinterpret_cast<uint4*>(out)[i] =
+            reinterpret_cast<const uint4*>(low + (row_of(r) * groups + static_cast<std::int64_t>(stage) * g) * 16)[c];
+    }
+    std::uint8_t* out_high = out + static_cast<std::int64_t>(rows_cta) * low_chunks * 16;
+    for (int i = threadIdx.x; i < rows_cta * high_chunks; i += blockDim.x) {
+        const int r = i / high_chunks, c = i % high_chunks;
+        reinterpret_cast<uint4*>(out_high)[i] =
+            reinterpret_cast<const uint4*>(high + (row_of(r) * groups + static_cast<std::int64_t>(stage) * g) * 8)[c];
+    }
+    std::uint8_t* out_scales = out_high + static_cast<std::int64_t>(rows_cta) * high_chunks * 16;
+    for (int i = threadIdx.x; i < rows_cta * g; i += blockDim.x) {
+        const int r = i / g, c = i % g;
+        out_scales[i] = ls8[row_of(r) * groups + static_cast<std::int64_t>(stage) * g + c];
+    }
+}
+
 } // namespace
 
+std::size_t q3_packed_bytes(const Weight& w) { return static_cast<std::size_t>(groups(w)) * 25; }
+
+void q3_pack_tiles(const Weight& w, void* dst, int rows_cta, int groups_per_stage, int paired_offset,
+                   cudaStream_t stream) {
+    require_q4(w);
+    const int row_groups = w.k / 64;
+    if (w.q3_low == nullptr || w.q3_high == nullptr || w.scales_ls8 == nullptr || w.q3_tile != 0 ||
+        rows_cta <= 0 || w.n % rows_cta != 0 || groups_per_stage % 2 != 0 || row_groups % groups_per_stage != 0 ||
+        (paired_offset > 0 && (rows_cta % 2 != 0 || 2 * paired_offset != w.n))) {
+        throw std::invalid_argument("q3 pack tiles: needs row-major Q3 planes, LS8 scales and a dividing schedule");
+    }
+    const int stages = row_groups / groups_per_stage;
+    const std::int64_t tiles = static_cast<std::int64_t>(w.n / rows_cta) * stages;
+    q3_pack_tiles_kernel<<<static_cast<unsigned>(tiles), 256, 0, stream>>>(
+        static_cast<const std::uint8_t*>(w.q3_low), static_cast<const std::uint8_t*>(w.q3_high),
+        static_cast<const std::uint8_t*>(w.scales_ls8), static_cast<std::uint8_t*>(dst), stages, rows_cta,
+        groups_per_stage, row_groups, paired_offset);
+    CUDA_CHECK(cudaGetLastError());
+}
