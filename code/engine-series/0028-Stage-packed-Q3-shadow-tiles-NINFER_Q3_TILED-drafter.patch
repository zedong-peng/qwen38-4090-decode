+namespace {
+// One thread per (row, 64-wide group) of a contiguous BF16 weight: canonical FP16 absmax scale, round-to-nearest
+// codes clamped to [-qmax, qmax], each value replaced by the BF16 rounding of c * s.
+__global__ void bf16_fake_requant_kernel(__nv_bfloat16* __restrict__ w, std::int64_t rows, int k, int bits) {
+    const std::int64_t index = static_cast<std::int64_t>(blockIdx.x) * blockDim.x + threadIdx.x;
+    const int groups         = k / 64;
+    if (index >= rows * groups) { return; }
+    __nv_bfloat16* p = w + (index / groups) * k + (index % groups) * 64;
+    float absmax     = 0.0f;
+    for (int i = 0; i < 64; ++i) { absmax = fmaxf(absmax, fabsf(__bfloat162float(p[i]))); }
+    const int qmax = (1 << (bits - 1)) - 1;
+    __half scale   = __float2half_rn(absmax / static_cast<float>(qmax));
+    if (__half2float(scale) == 0.0f && absmax > 0.0f) { scale = __ushort_as_half(1); }
+    const float s       = __half2float(scale);
+    const float inverse = s > 0.0f ? 1.0f / s : 0.0f;
+    for (int i = 0; i < 64; ++i) {
+        const int q = max(-qmax, min(qmax, __float2int_rn(__bfloat162float(p[i]) * inverse)));
+        p[i]        = __float2bfloat16_rn(static_cast<float>(q) * s);
+    }
+}
+} // namespace
+
+void bf16_fake_requantize_inplace(const Weight& w, int bits, cudaStream_t stream) {
+    if (w.qtype != QType::BF16 || w.k % 64 != 0 || w.qdata == nullptr || bits < 2 || bits > 8) {
+        throw std::invalid_argument("bf16 fake requantize: requires a contiguous BF16 weight with k % 64 == 0");
+    }
