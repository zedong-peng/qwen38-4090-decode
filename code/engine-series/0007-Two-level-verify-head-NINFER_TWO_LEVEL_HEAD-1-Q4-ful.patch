+// Two-level verify head: Q4 copy of the Q8 vocabulary head and exact Q8 rescoring of candidates.
+
+#include "core/weight.h"
+#include "ninfer/ops/linear_topk.h"
+
+#include "core/device.h"
+
+#include <cuda_bf16.h>
+#include <cuda_fp16.h>
+
+#include <cstdint>
+#include <stdexcept>
+
+namespace ninfer::ops {
+namespace {
+
+constexpr int kHidden   = 5120;
+constexpr int kQ8Groups = kHidden / 32;
+constexpr int kQ4Groups = kHidden / 64;
+constexpr int kTop      = 16;
+
+// One thread per (row, Q4 group): the two Q8 groups' values, the canonical absmax/7 FP16 scale,
+// round-to-nearest codes clamped to [-8,7], two's-complement nibbles packed low nibble first.
+__global__ void requant_q8_to_q4_kernel(const std::int8_t* __restrict__ q8_codes,
+                                        const __half* __restrict__ q8_scales,
+                                        std::uint8_t* __restrict__ q4_codes,
+                                        __half* __restrict__ q4_scales, std::int32_t rows) {
+    const std::int64_t index =
+        static_cast<std::int64_t>(blockIdx.x) * blockDim.x + threadIdx.x;
+    if (index >= static_cast<std::int64_t>(rows) * kQ4Groups) { return; }
+    const std::int64_t row = index / kQ4Groups;
+    const int group        = static_cast<int>(index % kQ4Groups);
+    const std::int8_t* src = q8_codes + row * kHidden + group * 64;
+    const float s0         = __half2float(q8_scales[row * kQ8Groups + 2 * group]);
+    const float s1         = __half2float(q8_scales[row * kQ8Groups + 2 * group + 1]);
+    float absmax           = 0.0f;
+    for (int i = 0; i < 64; ++i) {
+        absmax = fmaxf(absmax, fabsf(static_cast<float>(src[i]) * (i < 32 ? s0 : s1)));
+    }
+    __half scale = __float2half_rn(absmax / 7.0f);
+    if (__half2float(scale) == 0.0f && absmax > 0.0f) { scale = __ushort_as_half(1); }
+    const float s       = __half2float(scale);
+    const float inverse = s > 0.0f ? 1.0f / s : 0.0f;
+    std::uint8_t* dst   = q4_codes + row * (kHidden / 2) + group * 32;
+    for (int i = 0; i < 32; ++i) {
+        const float v0 = static_cast<float>(src[2 * i]) * (2 * i < 32 ? s0 : s1);
+        const float v1 = static_cast<float>(src[2 * i + 1]) * (2 * i + 1 < 32 ? s0 : s1);
+        const int c0   = max(-8, min(7, __float2int_rn(v0 * inverse)));
+        const int c1   = max(-8, min(7, __float2int_rn(v1 * inverse)));
+        dst[i]         = static_cast<std::uint8_t>((c0 & 15) | ((c1 & 15) << 4));
+    }
+    q4_scales[row * kQ4Groups + group] = scale;
+}
+
+// One CTA per column, one warp per candidate.
+__global__ void rescore_argmax_kernel(const __nv_bfloat16* __restrict__ hidden,
+                                      std::int64_t hidden_ld,
+                                      const std::int8_t* __restrict__ q8_codes,
+                                      const __half* __restrict__ q8_scales,
+                                      const std::int32_t* __restrict__ candidate_ids,
+                                      std::int32_t* __restrict__ tokens) {
+    __shared__ float score[kTop];
+    __shared__ int ids[kTop];
+    const int column = static_cast<int>(blockIdx.x);
+    const int warp   = static_cast<int>(threadIdx.x) >> 5;
+    const int lane   = static_cast<int>(threadIdx.x) & 31;
+    const int id     = candidate_ids[column * kTop + warp];
+    const std::int8_t* row      = q8_codes + static_cast<std::int64_t>(id) * kHidden;
+    const __half* row_scales    = q8_scales + static_cast<std::int64_t>(id) * kQ8Groups;
+    const __nv_bfloat16* x      = hidden + column * hidden_ld;
+    float acc                   = 0.0f;
+    for (int g = lane; g < kQ8Groups; g += 32) {
+        const int4* codes = reinterpret_cast<const int4*>(row + g * 32);
+        const int4* acts  = reinterpret_cast<const int4*>(x + g * 32);
+        float part        = 0.0f;
+#pragma unroll
+        for (int h = 0; h < 2; ++h) {
+            const int4 c          = codes[h];
+            const std::int8_t* cb = reinterpret_cast<const std::int8_t*>(&c);
+#pragma unroll
+            for (int q = 0; q < 2; ++q) {
+                const int4 a              = acts[2 * h + q];
+                const __nv_bfloat16* ab   = reinterpret_cast<const __nv_bfloat16*>(&a);
+#pragma unroll
+                for (int e = 0; e < 8; ++e) {
+                    part = fmaf(static_cast<float>(cb[8 * q + e]), __bfloat162float(ab[e]), part);
+                }
+            }
+        }
+        acc = fmaf(part, __half2float(row_scales[g]), acc);
+    }
+#pragma unroll
+    for (int offset = 16; offset > 0; offset >>= 1) {
+        acc += __shfl_xor_sync(0xffffffffu, acc, offset);
+    }
+    if (lane == 0) {
+        score[warp] = __bfloat162float(__float2bfloat16(acc));
+        ids[warp]   = id;
+    }
+    __syncthreads();
+    if (threadIdx.x == 0) {
+        float best  = score[0];
+        int best_id = ids[0];
+        for (int i = 1; i < kTop; ++i) {
+            if (score[i] > best || (score[i] == best && ids[i] < best_id)) {
+                best    = score[i];
+                best_id = ids[i];
+            }
+        }
+        tokens[column] = best_id;
+    }
+}
+
+void require_q8_head(const Weight& head) {
+    if (head.qtype != QType::Q8_G32_FP16 || head.layout != QuantLayout::RowSplit ||
+        head.n != 248320 || head.k != kHidden || head.padded_shape[1] != kHidden ||
+        head.qdata == nullptr || head.scales == nullptr) {
+        throw std::invalid_argument("two-level head: requires the Q8 [248320,5120] row-split head");
+    }
+}
+
+} // namespace
+
+void two_level_head_requantize(const Weight& q8_head, void* q4_codes, void* q4_scales,
+                               cudaStream_t stream) {
+    require_q8_head(q8_head);
+    const std::int64_t threads = static_cast<std::int64_t>(q8_head.n) * kQ4Groups;
+    requant_q8_to_q4_kernel<<<static_cast<unsigned>((threads + 255) / 256), 256, 0, stream>>>(
+        static_cast<const std::int8_t*>(q8_head.qdata),
+        static_cast<const __half*>(q8_head.scales), static_cast<std::uint8_t*>(q4_codes),
+        static_cast<__half*>(q4_scales), q8_head.n);
+    CUDA_CHECK(cudaGetLastError());
+}
+
+void two_level_head_rescore(const Tensor& hidden, const Weight& q8_head,
+                            const Tensor& candidate_ids, Tensor& tokens, cudaStream_t stream) {
+    require_q8_head(q8_head);
+    const std::int32_t columns = hidden.ne[1];
+    if (hidden.dtype != DType::BF16 || hidden.ne[0] != kHidden || candidate_ids.ne[0] != kTop ||
+        candidate_ids.ne[1] != columns || tokens.ne[0] != columns) {
+        throw std::invalid_argument("two-level head rescore: invalid tensors");
+    }
+    rescore_argmax_kernel<<<columns, 32 * kTop, 0, stream>>>(
+        static_cast<const __nv_bfloat16*>(hidden.data),
+        static_cast<std::int64_t>(hidden.nb[1] / sizeof(__nv_bfloat16)),
+        static_cast<const std::int8_t*>(q8_head.qdata),
+        static_cast<const __half*>(q8_head.scales),
+        static_cast<const std::int32_t*>(candidate_ids.data),
+        static_cast<std::int32_t*>(tokens.data));
+    CUDA_CHECK(cudaGetLastError());
+}
