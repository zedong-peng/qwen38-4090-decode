+// NINFER_TWO_LEVEL_HEAD=1: see ops::two_level_head_rescore. Built once, outside graph capture.
+struct TwoLevelHead {
+    DeviceBuffer codes;
+    DeviceBuffer scales;
+    Weight q4;
+    std::unique_ptr<DeviceArena> work;
+
+    void verify(const Tensor& hidden, const Weight& q8, Tensor& tokens, cudaStream_t stream) {
+        work->reset();
+        const std::int32_t columns = hidden.ne[1];
+        Tensor ids    = work->alloc(DType::I32, {16, columns});
+        Tensor scores = work->alloc(DType::FP32, {16, columns});
+        ops::linear_topk(hidden, q4, 248077, ids, scores, *work, stream);
+        ops::two_level_head_rescore(hidden, q8, ids, tokens, stream);
+    }
+};
+
+TwoLevelHead* two_level_head(const Weight& q8) {
+    static const bool enabled = [] {
+        const char* value = std::getenv("NINFER_TWO_LEVEL_HEAD");
+        return value != nullptr && value[0] == '1';
+    }();
+    if (!enabled || q8.qtype != QType::Q8_G32_FP16 || q8.n != 248320 || q8.k != 5120) {
+        return nullptr;
+    }
+    static std::unique_ptr<TwoLevelHead> head = [&] {
+        auto h    = std::make_unique<TwoLevelHead>();
+        h->codes  = DeviceBuffer(static_cast<std::size_t>(q8.n) * q8.k / 2);
+        h->scales = DeviceBuffer(static_cast<std::size_t>(q8.n) * (q8.k / 64) * 2);
+        ops::two_level_head_requantize(q8, h->codes.p, h->scales.p, nullptr);
+        CUDA_CHECK(cudaDeviceSynchronize());
+        Weight& w          = h->q4;
+        w.qtype            = QType::Q4_G64_FP16;
+        w.layout           = QuantLayout::RowSplit;
+        w.scale_dtype      = DType::FP16;
+        w.group_size       = 64;
+        w.group            = 64;
+        w.ndim             = 2;
+        w.n                = q8.n;
+        w.k                = q8.k;
+        w.shape[0]         = q8.n;
+        w.shape[1]         = q8.k;
+        w.padded_shape[0]  = q8.n;
+        w.padded_shape[1]  = q8.k;
+        w.qdata            = h->codes.p;
+        w.scales           = h->scales.p;
+        w.payload          = h->codes.p;
+        w.payload_bytes    = h->codes.bytes;
+        h->work = std::make_unique<DeviceArena>(
+            ops::linear_topk_workspace_capacity_bytes(QType::Q4_G64_FP16, q8.n, q8.k, 1, 16) +
+            (1u << 20));
+        std::fprintf(stderr, "two-level verify head: Q4 copy %.2f GiB, workspace %.1f MiB\n",
+                     static_cast<double>(h->codes.bytes + h->scales.bytes) / (1u << 30),
+                     static_cast<double>(h->work->capacity()) / (1u << 20));
+        return h;
+    }();
+    return head.get();
 }
 
+} // namespace
