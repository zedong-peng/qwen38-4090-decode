From b3c72aba5838c5456545cf2958d4c8c200c3b992 Mon Sep 17 00:00:00 2001
From: qwen38-4090 <noreply@localhost>
Date: Sat, 3 Oct 2026 05:57:07 +0800
Subject: [PATCH 08/49] Bind paired Q4/Q4 input projections

---
 src/ops/weight_input.cpp | 6 ++++--
 1 file changed, 4 insertions(+), 2 deletions(-)

diff --git a/src/ops/weight_input.cpp b/src/ops/weight_input.cpp
index 0111186..9108e68 100644
--- a/src/ops/weight_input.cpp
+++ b/src/ops/weight_input.cpp
@@ -142,8 +142,10 @@ ProjectionWeights input_projection(std::span<const WeightInput, 4> inputs, bool
     require(dense, "input projection: unsupported multi-parent geometry");
     const auto first  = single(inputs.first<2>());
     const auto second = single(inputs.last<2>());
-    require(first.weight.qtype == QType::Q4_G64_FP16 && second.weight.qtype == QType::Q5_G64_FP16,
-            "input projection: paired native form requires Q4 and Q5");
+    require(first.weight.qtype == QType::Q4_G64_FP16 &&
+                (second.weight.qtype == QType::Q5_G64_FP16 ||
+                 second.weight.qtype == QType::Q4_G64_FP16),
+            "input projection: paired native form requires Q4 and Q5 (or Q4) parents");
     return PairedProjectionWeights{first.weight, second.weight};
 }
 
