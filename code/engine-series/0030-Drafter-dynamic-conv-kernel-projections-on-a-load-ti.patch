--- a/src/ops/linear_topk/two_level_head.cu
+++ b/src/ops/linear_topk/two_level_head.cu
@@ -179,6 +179,40 @@ __global__ void bf16_fake_requant_kernel(__nv_bfloat16* __restrict__ w, std::int
 }
 } // namespace
 
+namespace {
+__global__ void bf16_to_q4_kernel(const __nv_bfloat16* __restrict__ w, std::uint8_t* __restrict__ codes,
+                                  __half* __restrict__ scales, std::int64_t rows, int k) {
+    const std::int64_t index = static_cast<std::int64_t>(blockIdx.x) * blockDim.x + threadIdx.x;
+    const int groups         = k / 64;
+    if (index >= rows * groups) { return; }
+    const __nv_bfloat16* p = w + (index / groups) * k + (index % groups) * 64;
+    float absmax           = 0.0f;
+    for (int i = 0; i < 64; ++i) { absmax = fmaxf(absmax, fabsf(__bfloat162float(p[i]))); }
+    __half scale = __float2half_rn(absmax / 7.0f);
+    if (__half2float(scale) == 0.0f && absmax > 0.0f) { scale = __ushort_as_half(1); }
+    const float s       = __half2float(scale);
+    const float inverse = s > 0.0f ? 1.0f / s : 0.0f;
+    std::uint8_t* c     = codes + index * 32;
+    for (int i = 0; i < 64; i += 2) {
+        const int q0 = max(-7, min(7, __float2int_rn(__bfloat162float(p[i]) * inverse)));
+        const int q1 = max(-7, min(7, __float2int_rn(__bfloat162float(p[i + 1]) * inverse)));
+        c[i / 2]     = static_cast<std::uint8_t>((q0 & 0xf) | ((q1 & 0xf) << 4));
+    }
+    scales[index] = scale;
+}
+} // namespace
+
+void bf16_to_q4_rowsplit(const Weight& w, void* codes, void* scales, cudaStream_t stream) {
+    if (w.qtype != QType::BF16 || w.k % 64 != 0 || w.qdata == nullptr) {
+        throw std::invalid_argument("bf16 to q4: requires a contiguous BF16 weight with k % 64 == 0");
+    }
+    const std::int64_t threads = static_cast<std::int64_t>(w.n) * (w.k / 64);
+    bf16_to_q4_kernel<<<static_cast<unsigned>((threads + 127) / 128), 128, 0, stream>>>(
+        static_cast<const __nv_bfloat16*>(w.qdata), static_cast<std::uint8_t*>(codes), static_cast<__half*>(scales),
+        w.n, w.k);
+    CUDA_CHECK(cudaGetLastError());
+}
+
 void bf16_fake_requantize_inplace(const Weight& w, int bits, cudaStream_t stream) {
     if (w.qtype != QType::BF16 || w.k % 64 != 0 || w.qdata == nullptr || bits < 2 || bits > 8) {
         throw std::invalid_argument("bf16 fake requantize: requires a contiguous BF16 weight with k % 64 == 0");
