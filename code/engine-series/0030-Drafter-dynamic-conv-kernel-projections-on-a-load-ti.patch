+++ b/src/ops/dynamic_grouped_conv/q4/q4_dynamic_grouped_conv_prepare.cu
@@ -0,0 +1,60 @@
+// Research (NINFER_DRAFT_CONV_Q4): Q4 dynamic-conv kernel projection on the Ada small-T kernel.
+
+#include "core/weight.h"
+#include "ops/dynamic_grouped_conv/bf16/bf16_dynamic_grouped_conv_prepare_kernels.h"
+
+#include "core/device.h"
+#include "ops/linear/ada_small_t_mma.cuh"
+
+#include <cuda_bf16.h>
+
+#include <cstdint>
+#include <stdexcept>
+
+namespace ninfer::ops::detail {
+namespace {
+constexpr int kHidden = 5120, kCoefficientRows = 1280;
+
+struct PartialEpilogue {
+    static constexpr bool kPairedHalves = false;
+    float* partial;
+    __device__ __forceinline__ void operator()(int row, int token, float value) const {
+        partial[static_cast<std::int64_t>(token) * kCoefficientRows + row] = value;
+    }
+};
+
+template <int TokenTiles>
+void launch(const __nv_bfloat16* x, int tokens, const Weight& w, float* partial, cudaStream_t stream) {
+    // 8-row CTAs: 160 CTAs for 1280 rows (a 3.3 MB weight cannot fill 128 SMs with larger tiles).
+    using S = Q4AdaSmallTSchedule<1, 8, TokenTiles, 8, 2>;
+    static_assert(kCoefficientRows % S::kRowsPerCta == 0);
+    ada_small_t_mma_launch<S, kHidden>(x, kHidden, static_cast<const std::uint8_t*>(w.qdata), nullptr, ada_scales(w),
+                                       kCoefficientRows, tokens, PartialEpilogue{partial}, stream, ada_super(w));
+    CUDA_CHECK(cudaGetLastError());
+}
+} // namespace
+
+void q4_dynamic_grouped_conv_prepare_partial_launch(const Tensor& input, const Weight& weight, float* partial,
+                                                    cudaStream_t stream) {
+    if (weight.qtype != QType::Q4_G64_FP16 || weight.layout != QuantLayout::RowSplit || weight.n != kCoefficientRows ||
+        weight.k != kHidden || weight.qdata == nullptr || weight.scales == nullptr) {
+        throw std::invalid_argument("q4 dynamic grouped conv prepare: requires a row-split Q4 G64 [1280,5120] weight");
+    }
+    const int tokens = input.ne[1] * input.ne[2];
+    if (tokens < 1 || !input.is_contiguous()) {
+        throw std::invalid_argument("q4 dynamic grouped conv prepare: requires contiguous [5120, W, B] columns");
+    }
+    // The small-T kernel takes up to 16 columns per launch; wider batches run in column chunks.
+    const auto* x = static_cast<const __nv_bfloat16*>(input.data);
+    for (int c0 = 0; c0 < tokens; c0 += 16) {
+        const int n = tokens - c0 < 16 ? tokens - c0 : 16;
+        const auto* xc = x + static_cast<std::int64_t>(c0) * kHidden;
+        float* pc      = partial + static_cast<std::int64_t>(c0) * kCoefficientRows;
+        if (n <= 8) {
+            launch<1>(xc, n, weight, pc, stream);
+        } else {
+            launch<2>(xc, n, weight, pc, stream);
+        }
+    }
+}
+} // namespace ninfer::ops::detail
