+// FP64 reference of the gated delta rule along each column's root path (value head h reads key head
+// h / (kHv / kQk); state rows are value dims, columns key dims; q, k L2-normalized with eps 1e-6).
+std::vector<double> reference(const std::vector<__nv_bfloat16>& q, const std::vector<__nv_bfloat16>& k,
+                              const std::vector<__nv_bfloat16>& v, const std::vector<float>& g,
+                              const std::vector<float>& beta, const std::vector<float>& states, int slot,
+                              const std::vector<std::int32_t>& parents, double scale) {
+    std::vector<double> out(static_cast<std::size_t>(kDim) * kHv * kWidth);
+    std::vector<double> S(static_cast<std::size_t>(kWidth) * kDim * kDim), kn(kDim), qn(kDim);
+    for (int h = 0; h < kHv; ++h) {
+        const int kh = h / (kHv / kQk);
+        const float* s0 = states.data() + (static_cast<std::size_t>(slot) * kHv + h) * kDim * kDim;
+        for (int i = 0; i < kWidth; ++i) {
+            const int p = parents[i];
+            double* Si = &S[static_cast<std::size_t>(i) * kDim * kDim];
+            for (int e = 0; e < kDim * kDim; ++e) Si[e] = p < 0 ? s0[e] : S[static_cast<std::size_t>(p) * kDim * kDim + e];
+            double ks = 0, qs = 0;
+            for (int d = 0; d < kDim; ++d) {
+                kn[d] = __bfloat162float(k[(static_cast<std::size_t>(i) * kQk + kh) * kDim + d]);
+                qn[d] = __bfloat162float(q[(static_cast<std::size_t>(i) * kQk + kh) * kDim + d]);
+                ks += kn[d] * kn[d]; qs += qn[d] * qn[d];
+            }
+            ks = 1.0 / std::sqrt(ks + 1e-6); qs = 1.0 / std::sqrt(qs + 1e-6);
+            for (int d = 0; d < kDim; ++d) { kn[d] *= ks; qn[d] *= qs; }
+            const double a = std::exp(static_cast<double>(g[static_cast<std::size_t>(i) * kHv + h]));
+            const double b = beta[static_cast<std::size_t>(i) * kHv + h];
+            for (int r = 0; r < kDim; ++r) {
+                double proj = 0;
+                for (int c = 0; c < kDim; ++c) proj += Si[r * kDim + c] * kn[c];
+                const double delta = b * (__bfloat162float(v[(static_cast<std::size_t>(i) * kHv + h) * kDim + r]) - a * proj);
+                double o = 0;
+                for (int c = 0; c < kDim; ++c) {
+                    Si[r * kDim + c] = a * Si[r * kDim + c] + delta * kn[c];
+                    o += Si[r * kDim + c] * qn[c];
+                }
+                out[(static_cast<std::size_t>(i) * kHv + h) * kDim + r] = scale * o;
+            }
+        }
+    }
+    return out;
+}
+
 } // namespace
 
