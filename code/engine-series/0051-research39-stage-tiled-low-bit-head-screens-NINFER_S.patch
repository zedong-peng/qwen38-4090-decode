+// research39 (NINFER_SCREEN_TILED=1): stage-tiled planes. The codes, high bits and scales of one screen CTA's 64 rows
+// and one pipeline stage (8 groups) are contiguous in each plane, so a stage is three contiguous reads instead of 64
+// row segments per plane. Same values, same shared-memory tiles, same arithmetic.
+constexpr int kTileRows   = 64;
+constexpr int kTileGroups = 8;
+
+// Byte offset of (row, group) in a stage-tiled plane with `bytes` bytes per group.
+__device__ __forceinline__ std::int64_t tiled_offset(std::int64_t row, int group, int bytes) {
+    const std::int64_t block = row / kTileRows;
+    const int r = static_cast<int>(row - block * kTileRows);
+    const int stage = group / kTileGroups, c = group - stage * kTileGroups;
+    return ((block * (kGroups / kTileGroups) + stage) * kTileRows + r) * (bytes * kTileGroups) + c * bytes;
+}
 
