--- a/include/ninfer/ops/q3_shadow.h
+++ b/include/ninfer/ops/q3_shadow.h
@@ -8,12 +8,14 @@
 
 namespace ninfer::ops {
 
-// Research (NINFER_Q3_SHADOW): whether every code of the row-split Q4 G64 weight w lies in [-4, 3].
-bool q3_codes_fit(const Weight& w, cudaStream_t stream);
+// Research (NINFER_Q3_SHADOW): 1 when every code of the row-split Q4 G64 weight w lies in [-4, 3],
+// else 2 when every code is odd (the half grid, 2c + 1), else 0.
+int q3_codes_kind(const Weight& w, cudaStream_t stream);
 // Bytes of w's Q3 low plane (16 per 64-weight group) and high plane (8 per group).
 std::size_t q3_low_bytes(const Weight& w);
 std::size_t q3_high_bytes(const Weight& w);
-// Repack w's Q4 codes (all in [-4, 3]) into the pair-split Q3 planes of ada_small_t_mma.cuh.
-void q3_transcode(const Weight& w, void* low, void* high, cudaStream_t stream);
+// Repack w's Q4 codes into the pair-split Q3 planes of ada_small_t_mma.cuh: u = c + 4 for codes in
+// [-4, 3], or u = (d + 7) / 2 for odd codes d (odd = true).
+void q3_transcode(const Weight& w, void* low, void* high, bool odd, cudaStream_t stream);
 
 } // namespace ninfer::ops
