 namespace ninfer {
 namespace {
@@ -40,44 +42,86 @@ void discard_capture(cudaStream_t stream) noexcept {
     destroy_graph(discard);
 }
 
+bool graph_split_enabled() {
+    static const bool enabled = [] {
+        const char* value = std::getenv("NINFER_GRAPH_SPLIT");
+        return value != nullptr && value[0] == '1';
+    }();
+    return enabled;
+}
+
+// The definition capturing on this thread, its stream, and the graph its first part ended in.
+struct ActiveCapture {
+    cudaStream_t stream = nullptr;
+    cudaGraph_t first   = nullptr;
+    bool active         = false;
+};
+thread_local ActiveCapture active_capture;
+
+std::pair<std::size_t, std::uint64_t> graph_signature(cudaGraph_t graph, std::uint64_t hash) {
+    std::size_t count = 0;
+    CUDA_CHECK(cudaGraphGetNodes(graph, nullptr, &count));
+    std::vector<cudaGraphNode_t> nodes(count);
+    CUDA_CHECK(cudaGraphGetNodes(graph, nodes.data(), &count));
+    for (cudaGraphNode_t node : nodes) {
+        cudaGraphNodeType type = cudaGraphNodeTypeEmpty;
+        CUDA_CHECK(cudaGraphNodeGetType(node, &type));
+        std::uint64_t payload = static_cast<std::uint64_t>(type) + 1U;
+        if (type == cudaGraphNodeTypeKernel) {
+            cudaKernelNodeParams params{};
+            CUDA_CHECK(cudaGraphKernelNodeGetParams(node, &params));
+            payload = payload * 1000003ULL ^ reinterpret_cast<std::uintptr_t>(params.func);
+        }
+        hash = (hash ^ payload) * 1099511628211ULL;
+    }
+    return {count, hash};
+}
+
 } // namespace
 
+void DecodeGraphDefinition::split_point(cudaStream_t stream) {
+    if (!graph_split_enabled() || !active_capture.active || active_capture.stream != stream ||
+        active_capture.first != nullptr) {
+        return;
+    }
+    cudaGraph_t first     = nullptr;
+    const cudaError_t err = cudaStreamEndCapture(stream, &first);
+    if (err != cudaSuccess) {
+        destroy_graph(first);
+        CUDA_CHECK(err);
+    }
+    active_capture.first = first;
+    CUDA_CHECK(cudaStreamBeginCapture(stream, cudaStreamCaptureModeThreadLocal));
+}
+
