-        if (type == cudaGraphNodeTypeKernel) {
-            cudaKernelNodeParams params{};
-            CUDA_CHECK(cudaGraphKernelNodeGetParams(node, &params));
-            payload = payload * 1000003ULL ^ reinterpret_cast<std::uintptr_t>(params.func);
-        }
-        hash = (hash ^ payload) * 1099511628211ULL;
+    auto signature = graph_signature(graph_, 1469598103934665603ULL);
+    if (graph2_ != nullptr) {
+        const auto second = graph_signature(graph2_, signature.second ^ 0x9e3779b97f4a7c15ULL);
+        signature         = {signature.first + second.first, second.second};
     }
-    return {count, hash};
+    return signature;
 }
 
 void DecodeGraphDefinition::capture(cudaStream_t stream, const std::function<void()>& body) {
@@ -85,42 +129,59 @@ void DecodeGraphDefinition::capture(cudaStream_t stream, const std::function<voi
     reset();
 
     CUDA_CHECK(cudaStreamBeginCapture(stream, cudaStreamCaptureModeThreadLocal));
+    active_capture = ActiveCapture{stream, nullptr, true};
 
     try {
         body();
     } catch (...) {
+        destroy_graph(active_capture.first);
+        active_capture = ActiveCapture{};
         discard_capture(stream);
         throw;
     }
+    cudaGraph_t first = active_capture.first;
+    active_capture    = ActiveCapture{};
 
     cudaGraph_t graph = nullptr;
 
     cudaError_t err = cudaStreamEndCapture(stream, &graph);
     if (err != cudaSuccess) {
