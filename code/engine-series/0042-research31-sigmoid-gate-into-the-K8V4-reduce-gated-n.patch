+
+// research31: verify-path fusion hand-offs (include/ninfer/ops/fused_tail.h).
+namespace ninfer::ops {
+namespace {
+bool env_flag(const char* name) {
+    const char* e = std::getenv(name);
+    const bool on = e != nullptr && std::atoi(e) == 1;
+    if (on) { std::fprintf(stderr, "%s=1\n", name); }
+    return on;
+}
+struct AttnGateState {
+    const void* gate = nullptr;
+    bool claimed     = false;
+};
+thread_local AttnGateState attn_gate_state;
+struct GatedNormState {
+    GatedNormFuse fuse;
+    bool set     = false;
+    bool claimed = false;
+};
+thread_local GatedNormState gated_norm_state;
+} // namespace
+
+bool fused_attn_gate_enabled() {
+    static const bool on = env_flag("NINFER_FUSED_ATTN_GATE");
+    return on;
+}
+void attn_gate_defer(const void* gate) { attn_gate_state = AttnGateState{gate, false}; }
+const void* attn_gate_claim() {
+    if (attn_gate_state.gate == nullptr || attn_gate_state.claimed) { return nullptr; }
+    attn_gate_state.claimed = true;
+    return attn_gate_state.gate;
+}
+bool attn_gate_finish() {
+    const bool applied = attn_gate_state.gate != nullptr && attn_gate_state.claimed;
+    attn_gate_state    = AttnGateState{};
+    return applied;
+}
+
+bool fused_gated_norm_enabled() {
+    static const bool on = env_flag("NINFER_FUSED_GATED_NORM");
+    return on;
+}
+void gated_norm_defer(const GatedNormFuse& fuse) { gated_norm_state = GatedNormState{fuse, true, false}; }
+bool gated_norm_claim(GatedNormFuse& fuse) {
+    if (!gated_norm_state.set || gated_norm_state.claimed) { return false; }
+    gated_norm_state.claimed = true;
+    fuse                     = gated_norm_state.fuse;
+    return true;
+}
+bool gated_norm_finish() {
+    const bool applied = gated_norm_state.set && gated_norm_state.claimed;
+    gated_norm_state   = GatedNormState{};
+    return applied;
+}
+} // namespace ninfer::ops
