diff --git a/include/ninfer/ops/fused_tail.h b/include/ninfer/ops/fused_tail.h
new file mode 100644
index 0000000..5c694fb
--- /dev/null
+++ b/include/ninfer/ops/fused_tail.h
@@ -0,0 +1,31 @@
+#pragma once
+
+// ninfer::ops - research31: verify-path ops folded into the kernel that produces their input. The model defers an
+// op, the launcher that can apply it claims it, and the model runs the separate kernel only when nothing claimed it.
+
+#include <cstdint>
+
+namespace ninfer::ops {
+
+// NINFER_FUSED_ATTN_GATE=1: the K8V4 reduce applies the attention output's sigmoid gate (sigmoid_mul).
+bool fused_attn_gate_enabled();
+void attn_gate_defer(const void* gate);
+// The reduce launch: the pending gate (nullptr if none), now marked applied.
+const void* attn_gate_claim();
+// After the attention call: true when a launcher applied the gate. Clears the pending state.
+bool attn_gate_finish();
+
+// NINFER_FUSED_GATED_NORM=1: the chunked GDN record applies gated_rmsnorm(o, weight, z, eps) -> out.
+struct GatedNormFuse {
+    const void* weight = nullptr;
+    const void* z      = nullptr;
+    void* out          = nullptr;
+    float eps          = 0.0F;
+    std::int32_t d     = 0;
+};
+bool fused_gated_norm_enabled();
+void gated_norm_defer(const GatedNormFuse& fuse);
+bool gated_norm_claim(GatedNormFuse& fuse);
+bool gated_norm_finish();
+
+} // namespace ninfer::ops
