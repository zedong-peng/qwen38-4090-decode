+        q.ne[3] <= kNormCounterBatches && v.ne[0] == 128) {
+        ops::GatedNormFuse norm;
+        if (ops::gated_norm_claim(norm)) {
+            static int* counters = [] {
+                void* p = nullptr;
+                CUDA_CHECK(cudaGetSymbolAddress(&p, g_gdn_norm_counters));
+                return static_cast<int*>(p);
+            }();
+            access.norm_weight   = static_cast<const __nv_bfloat16*>(norm.weight);
+            access.norm_z        = static_cast<const __nv_bfloat16*>(norm.z);
+            access.norm_out      = static_cast<__nv_bfloat16*>(norm.out);
+            access.norm_eps      = norm.eps;
+            access.norm_d        = norm.d;
+            access.norm_counters = counters;
+        }
+    }
     // research30 (NINFER_FUSED_CONV_RECORD=1): a convolution deferred by compose_record. The chunked route fuses it;
     // any other route (or a mismatch) launches it first, as before.
     ops::detail::PendingRecordConv conv = ops::detail::take_pending_record_conv();
