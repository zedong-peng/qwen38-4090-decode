         access.output_ptr(coord, i)[tile_dv + row] = __float2bfloat16(acc * access.scale);
     }
     zero_output_suffix(access, coord, valid, access.width);
+    if (access.norm_out != nullptr) {
+        // research31: the last value tile of this head normalizes its columns as rmsnorm_warp_bf16x2_kernel
+        // <Gated> does (one warp per column; lane l holds pairs l and l + 32).
+        __shared__ int norm_last;
+        __threadfence();
+        __syncthreads();
+        int* counter = access.norm_counters + static_cast<std::int64_t>(coord.batch) * access.heads.H_v +
+                       coord.value_head;
+        if (thread == 0) { norm_last = atomicAdd(counter, 1) == kStateDim / kBlockDv - 1; }
+        __syncthreads();
+        if (norm_last) {
+            __threadfence();
+            const int pairs = access.norm_d / 2;
+            const auto* x2  = reinterpret_cast<const __nv_bfloat162*>(access.out);
+            const auto* w2  = reinterpret_cast<const __nv_bfloat162*>(access.norm_weight);
+            const auto* z2  = reinterpret_cast<const __nv_bfloat162*>(access.norm_z);
+            auto* o2        = reinterpret_cast<__nv_bfloat162*>(access.norm_out);
+            for (int column = coord.warp; column < access.width; column += kNumWarps) {
+                const std::int64_t row_base =
+                    (access.column(coord, column) * access.heads.H_v + coord.value_head) * pairs;
+                __nv_bfloat162 values[4], weights[4], gates[4];
+                float sum = 0.0f;
+#pragma unroll
+                for (int k = 0; k < 4; ++k) {
+                    const int pair = coord.lane + k * kWarpSize;
+                    if (pair < pairs) {
+                        values[k]  = __ldcg(x2 + row_base + pair);
+                        weights[k] = w2[pair];
+                        gates[k]   = z2[row_base + pair];
+                        sum = __fadd_rn(sum, ops::rmsnorm_pair_square_sum(__bfloat1622float2(values[k])));
+                    }
+                }
+                sum       = ops::warp_reduce_sum(sum);
+                float inv = coord.lane == 0 ? rsqrtf(sum / static_cast<float>(access.norm_d) + access.norm_eps) : 0.0f;
+                inv       = __shfl_sync(kFullWarpMask, inv, 0);
+#pragma unroll
+                for (int k = 0; k < 4; ++k) {
+                    const int pair = coord.lane + k * kWarpSize;
+                    if (pair < pairs) {
+                        const float2 xf = __bfloat1622float2(values[k]);
+                        const float2 wf = __bfloat1622float2(weights[k]);
+                        const float2 zf = __bfloat1622float2(gates[k]);
+                        o2[row_base + pair] = __floats2bfloat162_rn(
+                            ops::rmsnorm_epilogue<ops::RmsEpilogue::Gated>(xf.x, inv, wf.x, zf.x),
+                            ops::rmsnorm_epilogue<ops::RmsEpilogue::Gated>(xf.y, inv, wf.y, zf.y));
+                    }
+                }
+            }
+            if (thread == 0) { *counter = 0; }
+        }
+    }
     l2_fill.consume(access.fill, next_state_word);
