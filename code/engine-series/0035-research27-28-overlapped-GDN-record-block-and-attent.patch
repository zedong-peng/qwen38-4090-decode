@@ -184,6 +186,58 @@ void gdn_projection_record_overlapped(const Tensor& residual, const Tensor& norm
                                     ops::GdnRecordRows::OutputGate, main);
 }
 
+int gdn_overlap_q4_level(const GdnParameters& parameters, std::int32_t batch, std::int32_t width) {
+    static const int level = [] {
+        const char* e = std::getenv("NINFER_GDN_OVERLAP");
+        const int v   = e != nullptr ? std::atoi(e) : 0;
+        if (v > 0) {
+            std::fprintf(stderr, "NINFER_GDN_OVERLAP=%d: paired-Q4 GDN record block in overlapped form%s\n", v,
+                         v >= 2 ? " (norm/control split)" : "");
+        }
+        return v;
+    }();
+    if (level <= 0) { return 0; }
+    const auto* pair = std::get_if<ops::PairedProjectionWeights>(&parameters.projection);
+    if (pair == nullptr || !ops::gdn_input_proj_record_halves_admit(pair->first, pair->second, batch, width)) {
+        return 0;
+    }
+    if (level >= 2 && !ops::gdn_norm_gating_split_admits(48, 5120, batch * width)) { return 1; }
+    return level >= 2 ? 2 : 1;
+}
+
+void gdn_norm_control_overlapped_q4(const Tensor& residual, const Tensor& norm, float epsilon,
+                                    const GdnParameters& parameters, Tensor& hidden, Tensor& g, Tensor& beta,
+                                    const DeviceContext& device) {
+    const cudaStream_t main = device.stream;
+    const cudaStream_t side = device.concurrent.stream;
+    ops::gdn_norm_gating_hidden(residual, norm, epsilon, hidden, main);
+    fork_concurrent(device, kGdnActivationReady, main);
+    if (const auto* pair = std::get_if<ops::PairedProjectionWeights>(&parameters.control)) {
+        ops::gdn_norm_gating_control(residual, norm, epsilon, pair->first, pair->second, parameters.a_log,
+                                     parameters.dt_bias, g, beta, side);
+    } else {
+        ops::gdn_norm_gating_control(residual, norm, epsilon, std::get<LinearParameters>(parameters.control).weight,
+                                     parameters.a_log, parameters.dt_bias, g, beta, side);
+    }
+}
+
+void gdn_projection_record_overlapped_q4(const Tensor& hidden, const GdnParameters& parameters,
+                                         const Tensor& conv_states, const Tensor& valid_columns,
+                                         const Tensor& initial_slots, const Tensor& tree_parents,
+                                         Tensor& conv_record, Tensor& query, Tensor& key, Tensor& value, Tensor& z,
+                                         const DeviceContext& device) {
+    const auto& pair        = std::get<ops::PairedProjectionWeights>(parameters.projection);
+    const cudaStream_t main = device.stream;
+    const cudaStream_t side = device.concurrent.stream;
+    ops::gdn_input_proj_record_half(hidden, pair.first, pair.second, conv_record, z,
+                                    ops::GdnRecordRows::QueryKeyValue, main);
+    fork_concurrent(device, kGdnQkvReady, main);
+    ops::gdn_input_proj_record_conv(parameters.convolution, conv_states, valid_columns, initial_slots, tree_parents,
+                                    conv_record, query, key, value, side);
+    ops::gdn_input_proj_record_half(hidden, pair.first, pair.second, conv_record, z, ops::GdnRecordRows::OutputGate,
+                                    main);
+}
+
 void gdn_join_concurrent(const DeviceContext& device, std::size_t event, cudaStream_t stream) {
     CUDA_CHECK(cudaStreamWaitEvent(stream, device.concurrent.events[event], 0));
 }
