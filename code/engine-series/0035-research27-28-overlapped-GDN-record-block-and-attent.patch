@@ -51,6 +53,30 @@ void attention_norm_projection(const Tensor& residual, const Tensor& norm, float
     }
 }
 
+bool attention_overlap_q4_admits(const AttentionParameters& parameters, std::int32_t tokens) {
+    static const bool on = [] {
+        const char* e = std::getenv("NINFER_ATTN_OVERLAP");
+        const bool v  = e != nullptr && std::atoi(e) > 0;
+        if (v) { std::fprintf(stderr, "NINFER_ATTN_OVERLAP: paired-Q4 attention block in overlapped form\n"); }
+        return v;
+    }();
+    if (!on) { return false; }
+    const auto* pair = std::get_if<ops::PairedProjectionWeights>(&parameters.projection);
+    return pair != nullptr && ops::attn_input_proj_halves_admit(pair->first, pair->second, tokens);
+}
+
+void attention_norm_projection_overlapped_q4(const Tensor& residual, const Tensor& norm, float eps,
+                                             const AttentionParameters& parameters, Tensor& hidden, Tensor& query,
+                                             Tensor& gate, Tensor& key, Tensor& value, const DeviceContext& device) {
+    const auto& pair        = std::get<ops::PairedProjectionWeights>(parameters.projection);
+    const cudaStream_t main = device.stream;
+    ops::rmsnorm(residual, norm, eps, true, hidden, main);
+    ops::attn_input_proj_half(hidden, pair.first, pair.second, query, gate, key, value, false, main);
+    CUDA_CHECK(cudaEventRecord(device.concurrent.events[kAttnQkvReady], main));
+    CUDA_CHECK(cudaStreamWaitEvent(device.concurrent.stream, device.concurrent.events[kAttnQkvReady], 0));
+    ops::attn_input_proj_half(hidden, pair.first, pair.second, query, gate, key, value, true, main);
+}
+
 void text_rope(const Tensor& positions, const RopeConfig& config, Tensor& query,
                cudaStream_t stream) {
     require_rope_axes(positions, config);
