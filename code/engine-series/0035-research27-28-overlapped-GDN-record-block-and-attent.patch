+    const auto launch = [&]<int Threads>() {
+        gdn_norm_27_bf16_hidden_kernel<Threads><<<x.ne[1], Threads, 0, stream>>>(
+            static_cast<const __nv_bfloat16*>(x.data), static_cast<const __nv_bfloat16*>(norm_weight.data),
