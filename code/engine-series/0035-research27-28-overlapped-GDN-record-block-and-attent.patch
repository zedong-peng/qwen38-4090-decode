+namespace {
+struct AttnRowsEpilogue {
+    static constexpr bool kPairedHalves = false;
+
+    __nv_bfloat16* out;
+    std::int32_t ld;
+
+    __device__ __forceinline__ void operator()(int row, int token, float result) const {
+        out[static_cast<std::int64_t>(token) * ld + row] = __float2bfloat16(result);
+    }
+};
