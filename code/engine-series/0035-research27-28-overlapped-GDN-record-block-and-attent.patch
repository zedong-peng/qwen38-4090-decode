+bool gdn_input_proj_record_halves_admit(const Weight& qk_weight, const Weight& value_z_weight,
+                                        std::int32_t batch_size, std::int32_t width) {
+    if (batch_size != 1 || width < 2 || width > 16 || qk_weight.n != 4096 || value_z_weight.n != 12288 ||
+        !detail::q4_gdn_input_halves_admit(qk_weight, value_z_weight, width)) {
+        return false;
+    }
+    const detail::Q4Q5GdnInputProblem problem{5120, qk_weight.n, value_z_weight.n, 4096 + 6144, 6144,
+                                              qk_weight.padded_shape[1], width};
+    return detail::q4_q5_gdn_input_resolve_plan(problem).schedule ==
+           detail::Q4Q5GdnInputScheduleId::IndependentDirectFixed;
+}
+
+void gdn_input_proj_record_half(const Tensor& x, const Weight& qk_weight, const Weight& value_z_weight,
+                                Tensor& conv_record, Tensor& z, GdnRecordRows rows, cudaStream_t stream) {
+    constexpr std::int32_t kQkRows = 4096, kValueRows = 6144, kZRows = 6144;
+    const ConvGeometry geometry    = require_record_input(x, 5120);
+    require_conv_tensor(conv_record, kQkRows + kValueRows, geometry.width, geometry.batch,
+                        "gdn_input_proj_record_half", "conv record");
+    require_conv_tensor(z, kZRows, geometry.width, geometry.batch, "gdn_input_proj_record_half", "z");
+    if (!gdn_input_proj_record_halves_admit(qk_weight, value_z_weight, geometry.batch, geometry.width)) {
+        throw std::invalid_argument("gdn_input_proj_record_half: problem not admitted");
+    }
+    // As compose_record -> gdn_input_proj -> q4_q5_gdn_input_execute_plan (IndependentDirectFixed) slices them.
+    Tensor x_flat      = flatten_columns(x, x.ne[0], geometry);
+    Tensor record_flat = flatten_columns(conv_record, conv_record.ne[0], geometry);
+    Tensor z_flat      = flatten_columns(z, z.ne[0], geometry);
+    Tensor qk          = record_flat.slice(0, 0, kQkRows);
+    Tensor value       = record_flat.slice(0, kQkRows, kZRows);
+    detail::q4_gdn_input_half_launch(x_flat, qk_weight, value_z_weight, qk, value, z_flat,
+                                     rows == GdnRecordRows::OutputGate, stream);
+}
+
+void gdn_input_proj_record_conv(const Tensor& conv_weight, const Tensor& conv_states, const Tensor& valid_columns,
+                                const Tensor& initial_state_slots, const Tensor& tree_parents,
+                                const Tensor& conv_record, Tensor& query, Tensor& key, Tensor& value,
+                                cudaStream_t stream) {
+    detail::gdn_projected_conv_record_launch(conv_record, conv_weight, conv_states, valid_columns,
+                                             initial_state_slots, tree_parents, query, key, value, stream);
+}
