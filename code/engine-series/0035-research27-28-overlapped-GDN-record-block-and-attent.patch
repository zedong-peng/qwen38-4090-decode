+// research27: the h of gdn_norm_gating_27_simt<*, Threads> for one token per CTA, as BF16: the norm exactly as
+// gdn_norm_27_fp8_hidden_kernel forms it (the fused kernel's chunk partition, FMA order, warp reductions and in-order
+// warp sum), each value rounded to BF16 as the fused kernel stores it.
+template <int Threads>
+__global__ __launch_bounds__(Threads) void gdn_norm_27_bf16_hidden_kernel(
+    const __nv_bfloat16* __restrict__ x, const __nv_bfloat16* __restrict__ nw, __nv_bfloat16* __restrict__ h,
+    float eps) {
+    constexpr int D = kGdn27Hidden, Warps = Threads / 32, Chunks = (D / 8 + Threads - 1) / Threads;
+    const int tid = threadIdx.x, lane = tid & 31, warp = tid >> 5;
+    const std::int64_t row = std::int64_t(blockIdx.x) * D;
+    int4 xv[Chunks]{}, nv[Chunks]{};
+#pragma unroll
+    for (int c = 0; c < Chunks; ++c) {
+        const int base = (tid + c * Threads) * 8;
+        if (base < D) {
+            xv[c] = load_vec<int4>(x + row + base);
+            nv[c] = load_vec<int4>(nw + base);
+        }
+    }
+    float ss = 0.0f;
+#pragma unroll
+    for (int c = 0; c < Chunks; ++c) {
+        if ((tid + c * Threads) * 8 < D) {
+            const auto* xp = reinterpret_cast<const unsigned*>(&xv[c]);
+#pragma unroll
+            for (int p = 0; p < 4; ++p) {
+                const float2 v = bf16x2_bits_to_float2(xp[p]);
+                ss             = fmaf(v.x, v.x, ss);
+                ss             = fmaf(v.y, v.y, ss);
+            }
+        }
+    }
+    __shared__ float partial[Warps], inverse_shared;
+    ss = warp_reduce_sum(ss);
+    if (lane == 0) { partial[warp] = ss; }
+    __syncthreads();
+    if (tid == 0) {
+        float s = 0;
+#pragma unroll
+        for (int w = 0; w < Warps; ++w) { s += partial[w]; }
+        inverse_shared = rsqrtf(s / D + eps);
+    }
+    __syncthreads();
+    const float inv = inverse_shared;
+#pragma unroll
+    for (int c = 0; c < Chunks; ++c) {
+        const int base = (tid + c * Threads) * 8;
+        if (base < D) {
+            const auto* xp = reinterpret_cast<const unsigned*>(&xv[c]);
+            const auto* np = reinterpret_cast<const unsigned*>(&nv[c]);
+            uint4 out;
+            auto* op = reinterpret_cast<__nv_bfloat162*>(&out);
+#pragma unroll
+            for (int p = 0; p < 4; ++p) {
+                const float2 v = bf16x2_bits_to_float2(xp[p]);
+                const float2 n = bf16x2_bits_to_float2(np[p]);
+                op[p]          = __floats2bfloat162_rn(v.x * inv * (1 + n.x), v.y * inv * (1 + n.y));
+            }
+            *reinterpret_cast<uint4*>(h + row + base) = out;
+        }
+    }
+}
 } // namespace
 
