+// The halves of launch_dual_ada<TokenTiles, GateValueRowTiles, QueryKeyGroups, true>.
+template <int TokenTiles, int GateValueRowTiles, int QueryKeyGroups>
+void launch_half_ada(const Tensor& x, const Weight& query_key_weight, const Weight& gate_value_weight, Tensor& q,
+                     Tensor& gate, Tensor& k, Tensor& v, bool gate_half, cudaStream_t stream) {
+    using SG = Q4AdaSmallTSchedule<GateValueRowTiles, 8, TokenTiles, 8, 2>;
+    using SQ = Q4AdaSmallTSchedule<2, 8, TokenTiles, QueryKeyGroups, 2>;
+    static_assert(kSplitRow % SG::kRowsPerCta == 0 && (kParentRows - kSplitRow) % SG::kRowsPerCta == 0 &&
+                  kParentRows % SQ::kRowsPerCta == 0);
+    const auto* x_data      = static_cast<const __nv_bfloat16*>(x.data);
+    const std::int32_t x_ld = static_cast<std::int32_t>(x.nb[1] / sizeof(__nv_bfloat16));
+    if (gate_half) {
+        ada_small_t_mma_launch<SG, kHidden>(
+            x_data, x_ld, static_cast<const std::uint8_t*>(gate_value_weight.qdata), nullptr,
+            ada_scales(gate_value_weight), kSplitRow, x.ne[1],
+            AttnRowsEpilogue{static_cast<__nv_bfloat16*>(gate.data),
+                             static_cast<std::int32_t>(gate.nb[1] / sizeof(__nv_bfloat16))},
+            stream, ada_super(gate_value_weight));
+    } else {
+        // Row-split planes: 32 code bytes and one LS8 byte (or one FP16 scale) per row and 64-weight group, and one
+        // LS8 super-scale per row, so the value rows start kSplitRow rows in.
+        constexpr std::int64_t kGroups = kHidden / 64;
+        const std::int64_t scale_bytes = gate_value_weight.scales_ls8 != nullptr ? 1 : 2;
+        const float* super             = ada_super(gate_value_weight);
+        // Same strides as launch_dual_ada's query/key store.
+        const AttnQueryKeyEpilogue query_key_epilogue{static_cast<__nv_bfloat16*>(q.data), q.ne[0],
+                                                      static_cast<__nv_bfloat16*>(k.data), k.ne[0]};
+        ada_small_t_mma_dual_launch<SG, kHidden, SQ, kHidden>(
+            x_data, x_ld, x.ne[1],
+            AdaSmallTOperand<AttnRowsEpilogue>{
+                static_cast<const std::uint8_t*>(gate_value_weight.qdata) + kSplitRow * kGroups * 32, nullptr,
+                ada_scales(gate_value_weight) + kSplitRow * kGroups * scale_bytes,
+                AttnRowsEpilogue{static_cast<__nv_bfloat16*>(v.data),
+                                 static_cast<std::int32_t>(v.nb[1] / sizeof(__nv_bfloat16))},
+                super != nullptr ? super + kSplitRow : nullptr},
+            kParentRows - kSplitRow,
+            AdaSmallTOperand<AttnQueryKeyEpilogue>{static_cast<const std::uint8_t*>(query_key_weight.qdata),
+                                                   nullptr, ada_scales(query_key_weight), query_key_epilogue,
+                                                   ada_super(query_key_weight)},
+            kParentRows, stream);
+    }
+    CUDA_CHECK(cudaGetLastError());
+}
