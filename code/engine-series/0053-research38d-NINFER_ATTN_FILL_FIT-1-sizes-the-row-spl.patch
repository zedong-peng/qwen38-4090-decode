+// research38d (NINFER_ATTN_FILL_FIT=1): the row-split / row-pair fill CTAs take only the spare resident slots.
+bool k8v4_fill_fit() {
+    static const bool fit = [] {
+        const char* value = std::getenv("NINFER_ATTN_FILL_FIT");
+        return value != nullptr && std::atoi(value) != 0;
+    }();
+    return fit;
+}
+
 int k8v4_rowsplit_sms() {
     static const int count = [] {
         int device = 0;
@@ -103,6 +112,18 @@ void launch_k8v4_partial(const Tensor& q, CacheInput input, const Tensor& positi
                 const std::uint32_t per = 8u * static_cast<std::uint32_t>(threads * ctas_per_slice);
                 return static_cast<std::int32_t>((fill_lines + per - 1) / per);
             };
+            // research38d: with NINFER_ATTN_FILL_FIT, one slice whose first fill_ctas CTAs fill the slots that two
+            // CTAs per SM leave next to the attention CTAs (16 lines per thread).
+            const auto fill_fit = [&](int threads, int ctas_per_slice, int slots, std::int32_t& fill_slices,
+                                      std::int32_t& fill_ctas) {
+                fill_ctas = 0;
+                if (!k8v4_fill_fit() || fill_lines == 0) { return; }
+                const int spare  = 2 * k8v4_rowsplit_sms() - ctas_per_slice * slots;
+                const int needed = static_cast<int>((fill_lines + 16u * threads - 1) / (16u * threads));
+                if (spare <= 0) { return; }
+                fill_ctas   = std::min(needed, spare);
+                fill_slices = (fill_ctas + ctas_per_slice - 1) / ctas_per_slice;
+            };
             if constexpr (CacheInput::writes_cache) {
                 causal_attention_small_t_k8v4_prepare_append_kernel<Geometry, TokenTile, false, Masked, CacheInput>
                     <<<(TokenTile * Geometry::KVHeads + 3) / 4, 128, 0, stream>>>(
@@ -121,13 +142,16 @@ void launch_k8v4_partial(const Tensor& q, CacheInput input, const Tensor& positi
