                 kernel<<<dim3(Geometry::KVHeads, RowGroups, slots + fill_slices), RP::Threads, RP::DynamicBytes,
                          stream>>>(q_ptr, positions_ptr, cache_k_ptr, cache_v_ptr, k_scale_ptr, v_scale_ptr,
                                    tables_ptr, valid_ptr, masks_ptr, rows_ptr, cache.block_tables.ne[0],
                                    invocation.full_width, invocation.column_begin, logical_capacity, splits, slots,
-                                   scale, partial_acc_ptr, partial_m_ptr, partial_l_ptr, fill, fill_slices);
+                                   scale, partial_acc_ptr, partial_m_ptr, partial_l_ptr, fill, fill_slices,
+                                   fill_ctas);
                 CUDA_CHECK(cudaGetLastError());
