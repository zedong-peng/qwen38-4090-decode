diff --git a/include/ninfer/ops/l2_fill.h b/include/ninfer/ops/l2_fill.h
new file mode 100644
index 0000000..5a9c88d
--- /dev/null
+++ b/include/ninfer/ops/l2_fill.h
@@ -0,0 +1,39 @@
+#pragma once
+
+// ninfer::ops - research29 (NINFER_L2_FILL): L2 fills of the next GEMM's first weight lines.
+//
+// A latency-bound kernel between two DRAM-bound GEMMs leaves DRAM almost idle. Given an L2Fill, it issues
+// 128-byte line loads (ld.global.cg.L2::128B) of the following GEMM's first weight rows at its start and
+// consumes them at its end, so the loads complete under its own work and the GEMM finds those rows in L2.
+// prefetch.global.L2 does not fill L2 on Ada (kernels/prefetch/bench_pf.cu). The loaded values only feed
+// a store through `sink`, which is always null, so no result changes.
+
+#include "core/weight.h"
+
+#include <cstdint>
+
+namespace ninfer::ops {
+
+struct L2FillRange {
+    const void* base    = nullptr; // 128-byte aligned
+    std::uint32_t lines = 0;       // 128-byte lines from base
+};
+
+struct L2Fill {
+    L2FillRange range[3];
+    std::uint32_t* sink = nullptr; // always null
+};
+
+// NINFER_L2_FILL (bit mask, read once); 0 when unset.
+int l2_fill_mask();
+// NINFER_L2_FILL_<name>_KB in bytes (read once per call site's name), or fallback.
+std::uint64_t l2_fill_bytes(const char* name, std::uint64_t fallback);
+// The lines holding the rows [skip_bytes, skip_bytes + bytes) of w, counted over every plane an Ada
+// small-T launch of w reads per row (Q4 codes or Q3 planes, then the group scales). Empty for other
+// layouts or unaligned planes.
+L2Fill l2_fill_for_weight(const Weight& w, std::uint64_t skip_bytes, std::uint64_t bytes);
+// Hands a fill from the model to the next launcher that takes one on this thread.
+void l2_fill_set(const L2Fill& fill);
+L2Fill l2_fill_take();
+
+} // namespace ninfer::ops
