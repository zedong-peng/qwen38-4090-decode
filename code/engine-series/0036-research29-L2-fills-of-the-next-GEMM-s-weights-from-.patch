diff --git a/src/ops/common/l2_fill.cuh b/src/ops/common/l2_fill.cuh
new file mode 100644
index 0000000..362320b
--- /dev/null
+++ b/src/ops/common/l2_fill.cuh
@@ -0,0 +1,49 @@
+#pragma once
+
+// research29 (NINFER_L2_FILL): device side of ninfer/ops/l2_fill.h.
+
+#include "ninfer/ops/l2_fill.h"
+
+#include <cstddef>
+#include <cstdint>
+
+namespace ninfer::ops::detail {
+
+// Up to L line loads per thread: thread t of T takes lines t, t + T, ... of the fill's ranges in order.
+template <int L>
+struct L2FillLoads {
+    std::uint32_t v[L];
+
+    __device__ __forceinline__ void issue(const L2Fill& fill, std::uint32_t t, std::uint32_t threads) {
+#pragma unroll
+        for (int j = 0; j < L; ++j) {
+            v[j]            = 0U;
+            std::uint32_t i = t + static_cast<std::uint32_t>(j) * threads;
+            const char* p   = nullptr;
+            if (i < fill.range[0].lines) {
+                p = static_cast<const char*>(fill.range[0].base) + static_cast<std::size_t>(i) * 128;
+            } else if ((i -= fill.range[0].lines) < fill.range[1].lines) {
+                p = static_cast<const char*>(fill.range[1].base) + static_cast<std::size_t>(i) * 128;
+            } else if ((i -= fill.range[1].lines) < fill.range[2].lines) {
+                p = static_cast<const char*>(fill.range[2].base) + static_cast<std::size_t>(i) * 128;
+            }
+            if (p != nullptr) { asm volatile("ld.global.cg.L2::128B.u32 %0, [%1];" : "=r"(v[j]) : "l"(p)); }
+        }
+    }
+
+    // Waits for the loads; `extra` joins another kept load.
+    __device__ __forceinline__ void consume(const L2Fill& fill, std::uint32_t extra = 0U) const {
+        std::uint32_t acc = extra;
+#pragma unroll
+        for (int j = 0; j < L; ++j) { acc ^= v[j]; }
+        if (fill.sink != nullptr) { *fill.sink = acc; }
+    }
+};
+
+__device__ __forceinline__ std::uint32_t l2_fill_line_load(const void* p) {
+    std::uint32_t v;
+    asm volatile("ld.global.cg.L2::128B.u32 %0, [%1];" : "=r"(v) : "l"(p));
+    return v;
+}
+
+} // namespace ninfer::ops::detail
diff --git a/src/ops/linear/l2_fill.cpp b/src/ops/linear/l2_fill.cpp
new file mode 100644
index 0000000..234831d
--- /dev/null
+++ b/src/ops/linear/l2_fill.cpp
@@ -0,0 +1,98 @@
+// research29 (NINFER_L2_FILL): host side of ninfer/ops/l2_fill.h.
+#include "ninfer/ops/l2_fill.h"
+
+#include <algorithm>
+#include <cstdio>
+#include <cstdlib>
+#include <map>
+#include <mutex>
+#include <string>
+
+namespace ninfer::ops {
+namespace {
+
+thread_local L2Fill pending_fill{};
+
+} // namespace
+
+int l2_fill_mask() {
+    static const int mask = [] {
+        const char* e = std::getenv("NINFER_L2_FILL");
+        const int m   = e != nullptr ? std::atoi(e) : 0;
+        if (m != 0) { std::fprintf(stderr, "NINFER_L2_FILL=%d: L2 fills of the next GEMM's weights\n", m); }
+        return m;
+    }();
+    return mask;
+}
+
+std::uint64_t l2_fill_bytes(const char* name, std::uint64_t fallback) {
+    static std::mutex mutex;
+    static std::map<std::string, std::uint64_t> cache;
+    const std::lock_guard<std::mutex> lock(mutex);
+    const auto it = cache.find(name);
+    if (it != cache.end()) { return it->second; }
+    const std::string key = std::string("NINFER_L2_FILL_") + name + "_KB";
+    const char* e         = std::getenv(key.c_str());
+    const std::uint64_t v = e != nullptr ? static_cast<std::uint64_t>(std::atoll(e)) << 10 : fallback;
+    if (e != nullptr) { std::fprintf(stderr, "%s=%s\n", key.c_str(), e); }
+    cache.emplace(name, v);
+    return v;
+}
+
+L2Fill l2_fill_for_weight(const Weight& w, std::uint64_t skip_bytes, std::uint64_t bytes) {
+    L2Fill fill{};
+    const std::int64_t rows = w.n;
+    const std::int64_t k    = w.k;
+    if (bytes == 0 || w.layout != QuantLayout::RowSplit || rows <= 0 || k <= 0 || k % 64 != 0) { return fill; }
+    const std::uint64_t groups = static_cast<std::uint64_t>(k / 64);
+    struct Plane {
+        const void* base;
+        std::uint64_t row_bytes;
+    };
+    Plane planes[3] = {};
+    int count       = 0;
+    const bool ls8  = w.scales_ls8 != nullptr;
+    if (w.q3_low != nullptr) {
+        if (w.q3_tile != 0) {
+            // Stage-packed tiles [low | high | LS8] in CTA order: a prefix is the first CTAs' rows.
+            planes[count++] = {w.q3_low, groups * (16 + 8 + 1)};
+        } else {
+            planes[count++] = {w.q3_low, groups * 16};
+            planes[count++] = {w.q3_high, groups * 8};
+        }
+    } else if (w.qtype == QType::Q4_G64_FP16 && w.qdata != nullptr) {
+        planes[count++] = {w.qdata, groups * 32};
+    } else {
+        return fill;
+    }
+    if (w.q3_tile == 0) {
+        planes[count++] = {ls8 ? w.scales_ls8 : w.scales, groups * (ls8 ? 1 : 2)};
+    }
+    std::uint64_t row_bytes = 0;
+    for (int i = 0; i < count; ++i) {
+        if (planes[i].base == nullptr || reinterpret_cast<std::uintptr_t>(planes[i].base) % 128 != 0) {
+            return L2Fill{};
+        }
+        row_bytes += planes[i].row_bytes;
+    }
+    const std::uint64_t r0 = std::min<std::uint64_t>(skip_bytes / row_bytes, rows);
+    const std::uint64_t r1 = std::min<std::uint64_t>((skip_bytes + bytes) / row_bytes, rows);
+    if (r1 <= r0) { return fill; }
+    for (int i = 0; i < count; ++i) {
+        const std::uint64_t first = r0 * planes[i].row_bytes / 128;
+        const std::uint64_t last  = (r1 * planes[i].row_bytes + 127) / 128;
+        fill.range[i]             = {static_cast<const char*>(planes[i].base) + first * 128,
+                                     static_cast<std::uint32_t>(last - first)};
+    }
+    return fill;
+}
+
+void l2_fill_set(const L2Fill& fill) { pending_fill = fill; }
+
+L2Fill l2_fill_take() {
+    const L2Fill fill = pending_fill;
+    pending_fill      = L2Fill{};
+    return fill;
+}
+
+} // namespace ninfer::ops
