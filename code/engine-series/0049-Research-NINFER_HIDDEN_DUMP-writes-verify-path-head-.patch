diff --git a/src/models/qwen3_5/program/research_hidden_dump.h b/src/models/qwen3_5/program/research_hidden_dump.h
new file mode 100644
index 0000000..d5cf0e1
--- /dev/null
+++ b/src/models/qwen3_5/program/research_hidden_dump.h
@@ -0,0 +1,17 @@
+// Research (NINFER_HIDDEN_DUMP=FILE, tools/patch_hidden_dump.py): decode-path fidelity dumps.
+#pragma once
+
+#include <cstdio>
+#include <cstdlib>
+
+namespace ninfer::models::qwen3_5::execution {
+
+inline std::FILE* research_hidden_dump() {
+    static std::FILE* const file = []() -> std::FILE* {
+        const char* path = std::getenv("NINFER_HIDDEN_DUMP");
+        return path != nullptr && *path != 0 ? std::fopen(path, "wb") : nullptr;
+    }();
+    return file;
+}
+
+} // namespace ninfer::models::qwen3_5::execution
