+// Research (NINFER_Q3_SHADOW): whether every code of the row-split Q4 G64 weight w lies in [-4, 3].
+bool q3_codes_fit(const Weight& w, cudaStream_t stream);
+// Bytes of w's Q3 low plane (16 per 64-weight group) and high plane (8 per group).
+std::size_t q3_low_bytes(const Weight& w);
+std::size_t q3_high_bytes(const Weight& w);
+// Repack w's Q4 codes (all in [-4, 3]) into the pair-split Q3 planes of ada_small_t_mma.cuh.
+void q3_transcode(const Weight& w, void* low, void* high, cudaStream_t stream);
+
