diff --git a/src/ops/linear/q3_shadow.cu b/src/ops/linear/q3_shadow.cu
new file mode 100644
index 0000000..a709654
--- /dev/null
+++ b/src/ops/linear/q3_shadow.cu
@@ -0,0 +1,84 @@
+// Research (NINFER_Q3_SHADOW): Q3 planes for row-split Q4 G64 weights whose codes all lie in [-4, 3].
+
+#include "ninfer/ops/q3_shadow.h"
+
+#include "core/device.h"
+
+#include <cstdint>
+#include <stdexcept>
+
+namespace ninfer::ops {
+namespace {
+
+void require_q4(const Weight& w) {
+    if (w.qtype != QType::Q4_G64_FP16 || w.layout != QuantLayout::RowSplit || w.qdata == nullptr ||
+        w.k % 64 != 0 || w.padded_shape[1] != w.k) {
+        throw std::invalid_argument("q3 shadow: requires an unpadded row-split Q4 G64 weight");
+    }
+}
+
+std::int64_t groups(const Weight& w) { return static_cast<std::int64_t>(w.n) * (w.k / 64); }
+
+// A nibble holds a code in [-4, 3] (0-3 or 12-15) exactly when its bits 3 and 2 agree.
+__global__ void q3_fit_kernel(const uint4* __restrict__ codes, std::int64_t vectors,
+                              int* __restrict__ misfit) {
+    bool fits = true;
+    for (std::int64_t i = blockIdx.x * static_cast<std::int64_t>(blockDim.x) + threadIdx.x;
+         i < vectors; i += static_cast<std::int64_t>(gridDim.x) * blockDim.x) {
+        const uint4 v = codes[i];
+        fits &= ((((v.x >> 1) ^ v.x) | ((v.y >> 1) ^ v.y) | ((v.z >> 1) ^ v.z) | ((v.w >> 1) ^ v.w)) &
+                 0x44444444u) == 0;
+    }
+    if (!__syncthreads_and(fits) && threadIdx.x == 0) { atomicOr(misfit, 1); }
+}
+
+// One thread per group: the 64 Q4 codes (weight i at bits 4 (i % 8) of word i / 8) as u = c + 4, chunk j
+// (weights 16j + t, pair p = t / 2) in low word j (bits 2p and 16 + 2p) and high half j (bits p and 8 + p).
+__global__ void q3_transcode_kernel(const uint4* __restrict__ codes, std::int64_t count,
+                                    uint4* __restrict__ low, uint2* __restrict__ high) {
+    const std::int64_t g = blockIdx.x * static_cast<std::int64_t>(blockDim.x) + threadIdx.x;
+    if (g >= count) { return; }
+    const uint4 a = codes[2 * g], b = codes[2 * g + 1];
+    const unsigned words[8] = {a.x, a.y, a.z, a.w, b.x, b.y, b.z, b.w};
+    unsigned lo[4] = {0u, 0u, 0u, 0u};
+    unsigned hi[2] = {0u, 0u};
+#pragma unroll
+    for (int i = 0; i < 64; ++i) {
+        const unsigned u = (((words[i >> 3] >> (4 * (i & 7))) & 0xfu) + 4u) & 0xfu;
+        const int j = i >> 4, t = i & 15, p = t >> 1, second = t & 1;
+        lo[j] |= (u & 3u) << (16 * second + 2 * p);
+        hi[j >> 1] |= ((u >> 2) & 1u) << (16 * (j & 1) + 8 * second + p);
+    }
+    low[g]  = make_uint4(lo[0], lo[1], lo[2], lo[3]);
+    high[g] = make_uint2(hi[0], hi[1]);
+}
+
+} // namespace
+
+bool q3_codes_fit(const Weight& w, cudaStream_t stream) {
+    require_q4(w);
+    int* misfit = nullptr;
+    CUDA_CHECK(cudaMallocAsync(reinterpret_cast<void**>(&misfit), sizeof(int), stream));
+    CUDA_CHECK(cudaMemsetAsync(misfit, 0, sizeof(int), stream));
+    q3_fit_kernel<<<1024, 256, 0, stream>>>(static_cast<const uint4*>(w.qdata), groups(w) * 2, misfit);
+    CUDA_CHECK(cudaGetLastError());
+    int host = 1;
+    CUDA_CHECK(cudaMemcpyAsync(&host, misfit, sizeof(int), cudaMemcpyDeviceToHost, stream));
+    CUDA_CHECK(cudaFreeAsync(misfit, stream));
+    CUDA_CHECK(cudaStreamSynchronize(stream));
+    return host == 0;
+}
+
+std::size_t q3_low_bytes(const Weight& w) { return static_cast<std::size_t>(groups(w)) * 16; }
+
+std::size_t q3_high_bytes(const Weight& w) { return static_cast<std::size_t>(groups(w)) * 8; }
+
+void q3_transcode(const Weight& w, void* low, void* high, cudaStream_t stream) {
+    require_q4(w);
+    const std::int64_t count = groups(w);
+    q3_transcode_kernel<<<static_cast<unsigned>((count + 255) / 256), 256, 0, stream>>>(
+        static_cast<const uint4*>(w.qdata), count, static_cast<uint4*>(low), static_cast<uint2*>(high));
+    CUDA_CHECK(cudaGetLastError());
+}
+
+} // namespace ninfer::ops
