+// Research: NINFER_Q3_SHADOW=1 gives row-split Q4 G64 weights whose codes all lie in [-4, 3] Q3 planes
+// (ops::q3_transcode) for the Ada small-T routes; the Q4 codes stay for every other route. Device
+// memory lives for the process.
+struct Q3ShadowPass {
+    std::size_t bytes = 0;
+    int weights       = 0;
+    int checked       = 0;
+    void operator()(Weight& w) {
+        if (w.qtype != QType::Q4_G64_FP16 || w.layout != QuantLayout::RowSplit || w.qdata == nullptr ||
+            w.k % 64 != 0 || w.padded_shape[1] != w.k) {
+            return;
+        }
+        ++checked;
+        if (!ops::q3_codes_fit(w, nullptr)) { return; }
+        const std::size_t low  = ops::q3_low_bytes(w);
+        const std::size_t high = ops::q3_high_bytes(w);
+        void* memory           = nullptr;
+        CUDA_CHECK(cudaMalloc(&memory, low + high));
+        void* high_plane = static_cast<std::uint8_t*>(memory) + low;
+        ops::q3_transcode(w, memory, high_plane, nullptr);
+        w.q3_low  = memory;
+        w.q3_high = high_plane;
+        bytes += low + high;
+        ++weights;
+    }
+};
+
 } // namespace
 
