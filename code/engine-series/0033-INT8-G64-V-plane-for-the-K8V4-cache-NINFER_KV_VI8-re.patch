diff --git a/src/ops/kv_cache/k8v4_value.cuh b/src/ops/kv_cache/k8v4_value.cuh
new file mode 100644
index 0000000..d659ca4
--- /dev/null
+++ b/src/ops/kv_cache/k8v4_value.cuh
@@ -0,0 +1,92 @@
+#pragma once
+
+// Research (NINFER_KV_VI8=1, see k8v4_value_int8() in core/paged_kv_storage.h): the V plane of --kv-dtype k8v4.
+// K8V4Value<false> is the release codec, the Hadamard-rotated row as NVFP4 G16 (128 code bytes and 16 E4M3 group
+// scales per row). K8V4Value<true> stores the same rotated row as INT8 G64 (256 code bytes and four FP16 group
+// scales per row, the INT8 storage's V plane). Both widen to FP16 for the K8V4 PV MMAs; K is FP8 rows either way.
+
+#include "ops/common/memory.cuh"
+#include "ops/common/warp.cuh"
+#include "ops/kv_cache/int8_g64_codec.cuh"
+#include "ops/kv_cache/nvfp4_group16_codec.cuh"
+
+#include <cuda_bf16.h>
+#include <cuda_fp16.h>
+
+#include <cstdint>
+
+namespace ninfer::ops {
+
+template <bool VInt8>
+struct K8V4Value {
+    // Bytes per cache row.
+    static constexpr int kCodeBytes  = VInt8 ? kKVCacheInt8HeadDim : kKVCacheNvfp4CodeBytes;
+    static constexpr int kScaleBytes = VInt8 ? kKVCacheInt8Groups * 2 : kKVCacheNvfp4Groups;
+
+    // Byte offset of the row's code bytes (dimension 0) and of its first scale byte.
+    template <typename Geometry>
+    __device__ __forceinline__ static std::int64_t code_offset(int page, int kv_head,
+                                                               int page_offset) {
+        if constexpr (VInt8) {
+            return kv_cache_int8_quant_code_index<Geometry>(page, kv_head, 0, page_offset);
+        } else {
+            return kv_cache_nvfp4_code_index<Geometry>(page, kv_head, 0, page_offset);
+        }
+    }
+    template <typename Geometry>
+    __device__ __forceinline__ static std::int64_t scale_offset(int page, int kv_head,
+                                                                int page_offset) {
+        if constexpr (VInt8) {
+            return 2 * kv_cache_int8_quant_scale_index<Geometry>(page, kv_head, 0, page_offset);
+        } else {
+            return kv_cache_nvfp4_scale_index<Geometry>(page, kv_head, 0, page_offset);
+        }
+    }
+};
+
+// Eight INT8 codes times an FP16 scale as eight FP16 values. FP16 bits 0x6400 | u are exactly 1024 + u for u < 1024,
+// so with u = c ^ 0x80 (= c + 128) every code c is exactly (1024 + u) - 1152 before the scale multiply.
+__device__ __forceinline__ int4 k8v4_value_i8x8_to_f16x8(uint2 raw, __half scale) {
+    const __half2 scale2 = __halves2half2(scale, scale);
+    const __half2 bias   = __float2half2_rn(1152.0F);
+    const std::uint32_t words[2] = {raw.x ^ 0x80808080U, raw.y ^ 0x80808080U};
+    unsigned half_bits[4];
+#pragma unroll
+    for (int pair = 0; pair < 4; ++pair) {
+        const std::uint32_t bits =
+            __byte_perm(words[pair >> 1], 0x64646464U, (pair & 1) != 0 ? 0x5342U : 0x5140U);
+        const __half2 value =
+            __hmul2(__hsub2(*reinterpret_cast<const __half2*>(&bits), bias), scale2);
+        half_bits[pair] = *reinterpret_cast<const unsigned*>(&value);
+    }
+    return make_int4(static_cast<int>(half_bits[0]), static_cast<int>(half_bits[1]),
+                     static_cast<int>(half_bits[2]), static_cast<int>(half_bits[3]));
+}
+
+// INT8 G64 quantization of one rotated D256 row held by a warp (lane l owns dimension l + 32r in values[r]; group g
+// is values[2g], values[2g + 1]). Same scale and code rules as the INT8 storage (kv_cache_int8_quant_params).
+template <typename Geometry>
+__device__ __forceinline__ void k8v4_value_store_int8_row(const float (&values)[8], int lane,
+                                                          std::uint8_t* cache_v,
+                                                          std::uint8_t* cache_v_scale, int page,
+                                                          int kv_head, int page_offset) {
+    constexpr unsigned FullMask = 0xffffffffU;
+    auto* const scales          = reinterpret_cast<__half*>(cache_v_scale);
+#pragma unroll
+    for (int group = 0; group < kKVCacheInt8Groups; ++group) {
+        const float a0     = values[2 * group];
+        const float a1     = values[2 * group + 1];
+        const auto quant   = kv_cache_int8_quant_params(warp_max(fmaxf(fabsf(a0), fabsf(a1)), FullMask));
+        const int d0       = lane + 64 * group;
+        cache_v[kv_cache_int8_quant_code_index<Geometry>(page, kv_head, d0, page_offset)] =
+            static_cast<std::uint8_t>(kv_cache_int8_quant_code(a0, quant.inverse_scale));
+        cache_v[kv_cache_int8_quant_code_index<Geometry>(page, kv_head, d0 + 32, page_offset)] =
+            static_cast<std::uint8_t>(kv_cache_int8_quant_code(a1, quant.inverse_scale));
+        if (lane == 0) {
+            scales[kv_cache_int8_quant_scale_index<Geometry>(page, kv_head, group, page_offset)] =
+                quant.scale;
+        }
+    }
+}
+
+} // namespace ninfer::ops
