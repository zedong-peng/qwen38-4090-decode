+                q_scale_r1 = q_scale_s[gid + 8];
+                first      = false;
+            }
+            // QK of pair tile tg (score tile `quarter` of the wide kernel).
+            float score[4]    = {0.0F, 0.0F, 0.0F, 0.0F};
+            const bool scores = tg < n;
+            if (scores) {
+                const int stage   = (g + tg) & 1;
+                const int k0      = range.first_tile + (kb + tg) * Bc;
+                const auto* k_b16 = reinterpret_cast<const __nv_bfloat16*>(stage_k(stage));
+#pragma unroll
+                for (int kk = 0; kk < QKKs; ++kk) {
+                    unsigned bf[2];
+                    ldmatrix_x2(bf[0], bf[1],
+                                smem_addr(&k_b16[b_row * DB16 +
+                                                 causal_small_t_tc_swz(b_row, kk * 16 + b_koff)]));
+                    mma_fp8_e4m3(score[0], score[1], score[2], score[3], qf[kk][0], qf[kk][1],
+                                 qf[kk][2], qf[kk][3], bf[0], bf[1]);
+                }
+                const __half* k_scale = stage_ks(stage);
+                const float ks0       = __half2float(k_scale[keya]);
+                const float ks1       = __half2float(k_scale[keya + 1]);
+                score[0] *= q_scale_r0 * ks0;
+                score[1] *= q_scale_r0 * ks1;
+                score[2] *= q_scale_r1 * ks0;
+                score[3] *= q_scale_r1 * ks1;
+                const int key0 = k0 + keya;
+                const int key1 = key0 + 1;
+                const bool in0 = key0 >= range.split_start && key0 < range.split_end;
+                const bool in1 = key1 >= range.split_start && key1 < range.split_end;
+                score[0] = in0 && k8v4_key_visible(key0, qabs0, base0, mask0)
+                               ? score[0] * attention_scale
+                               : -CUDART_INF_F;
+                score[1] = in1 && k8v4_key_visible(key1, qabs0, base0, mask0)
+                               ? score[1] * attention_scale
+                               : -CUDART_INF_F;
+                score[2] = in0 && k8v4_key_visible(key0, qabs1, base1, mask1)
+                               ? score[2] * attention_scale
+                               : -CUDART_INF_F;
+                score[3] = in1 && k8v4_key_visible(key1, qabs1, base1, mask1)
+                               ? score[3] * attention_scale
+                               : -CUDART_INF_F;
+                const float bm0 = warp_max<4>(fmaxf(score[0], score[1]), FullMask);
+                const float bm1 = warp_max<4>(fmaxf(score[2], score[3]), FullMask);
+                if (lid == 0) {
+                    bmax_s[tg][quarter][gid]     = bm0;
+                    bmax_s[tg][quarter][gid + 8] = bm1;
+                }
+            }
+            __syncthreads();
+            // Every warp has scored: the key stages take the next pair.
+            for (; issued_k < min(g + n + 2, total_tiles); ++issued_k) issue_k(issued_k);
+            cp_commit();
+            // The pair's online-softmax steps, A then B, in every warp; each warp makes P of its tile.
+            const float na0 = fmaxf(m0, fmaxf(fmaxf(bmax_s[0][0][gid], bmax_s[0][1][gid]),
+                                              fmaxf(bmax_s[0][2][gid], bmax_s[0][3][gid])));
+            const float na1 =
+                fmaxf(m1, fmaxf(fmaxf(bmax_s[0][0][gid + 8], bmax_s[0][1][gid + 8]),
+                                fmaxf(bmax_s[0][2][gid + 8], bmax_s[0][3][gid + 8])));
+            const float aa0 = m0 == -CUDART_INF_F ? 0.0F : exp2_approx((m0 - na0) * Log2E);
+            const float aa1 = m1 == -CUDART_INF_F ? 0.0F : exp2_approx((m1 - na1) * Log2E);
+            float nb0 = na0, nb1 = na1, ab0 = 1.0F, ab1 = 1.0F;
+            if (n == 2) {
+                nb0 = fmaxf(na0, fmaxf(fmaxf(bmax_s[1][0][gid], bmax_s[1][1][gid]),
+                                       fmaxf(bmax_s[1][2][gid], bmax_s[1][3][gid])));
+                nb1 = fmaxf(na1, fmaxf(fmaxf(bmax_s[1][0][gid + 8], bmax_s[1][1][gid + 8]),
+                                       fmaxf(bmax_s[1][2][gid + 8], bmax_s[1][3][gid + 8])));
+                ab0 = na0 == -CUDART_INF_F ? 0.0F : exp2_approx((na0 - nb0) * Log2E);
+                ab1 = na1 == -CUDART_INF_F ? 0.0F : exp2_approx((na1 - nb1) * Log2E);
+            }
+            if (scores) {
+                const float nm0 = tg == 0 ? na0 : nb0;
+                const float nm1 = tg == 0 ? na1 : nb1;
+                score[0]        = nm0 > -CUDART_INF_F && score[0] > -CUDART_INF_F
+                                      ? exp2_approx((score[0] - nm0) * Log2E)
+                                      : 0.0F;
+                score[1]        = nm0 > -CUDART_INF_F && score[1] > -CUDART_INF_F
+                                      ? exp2_approx((score[1] - nm0) * Log2E)
+                                      : 0.0F;
+                score[2]        = nm1 > -CUDART_INF_F && score[2] > -CUDART_INF_F
+                                      ? exp2_approx((score[2] - nm1) * Log2E)
+                                      : 0.0F;
+                score[3]        = nm1 > -CUDART_INF_F && score[3] > -CUDART_INF_F
+                                      ? exp2_approx((score[3] - nm1) * Log2E)
+                                      : 0.0F;
+                tbuf_s[tg][quarter][lane] = make_float2(score[0] + score[1], score[2] + score[3]);
+                pbuf_s[tg][quarter >> 1][2 * (quarter & 1)][lane] =
+                    k8v4_half2_bits(score[0], score[1]);
+                pbuf_s[tg][quarter >> 1][2 * (quarter & 1) + 1][lane] =
+                    k8v4_half2_bits(score[2], score[3]);
+            }
+            // This pair's values (the group before the next keys) have landed.
+            cp_wait<1>();
+            __syncthreads();
+            pv(0, g & 1, aa0, aa1);
+            if (n == 2) pv(1, (g + 1) & 1, ab0, ab1);
+            m0 = nb0;
+            m1 = nb1;
+            g += n;
+            if (issued_v < total_tiles) {
+                // Every warp has finished PV: the value stages take the next pair.
+                __syncthreads();
+                for (; issued_v < min(g + 2, total_tiles); ++issued_v) issue_v(issued_v);
+                cp_commit();
+            }
+        }
+        K8V4_ROWSPLIT_STAMP(5);
+        // The split is complete: statistics (identical in all warps) and the doubled numerators.
+        if (warp == 0 && lid == 0) {
+            partial_m[causal_partial_stat_index<Geometry>(q_head0, token0, split, TokenTile)] = m0;
+            partial_l[causal_partial_stat_index<Geometry>(q_head0, token0, split, TokenTile)] = l0;
+            partial_m[causal_partial_stat_index<Geometry>(q_head1, token1, split, TokenTile)] = m1;
+            partial_l[causal_partial_stat_index<Geometry>(q_head1, token1, split, TokenTile)] = l1;
+        }
+        const int d0 = 32 * warp + 8 * lid;
+        float* const out0 =
+            partial_acc + causal_partial_acc_index<Geometry>(q_head0, d0, token0, split, TokenTile);
+        float* const out1 =
+            partial_acc + causal_partial_acc_index<Geometry>(q_head1, d0, token1, split, TokenTile);
+#pragma unroll
+        for (int h = 0; h < 2; ++h) {
+            store_vec(out0 + 4 * h, make_float4(2.0F * acc[0][h], 2.0F * acc[1][h],
+                                                2.0F * acc[2][h], 2.0F * acc[3][h]));
+            store_vec(out1 + 4 * h, make_float4(2.0F * acc[0][2 + h], 2.0F * acc[1][2 + h],
+                                                2.0F * acc[2][2 + h], 2.0F * acc[3][2 + h]));
+        }
+        m0 = m1 = -CUDART_INF_F;
+        l0 = l1 = 0.0F;
+#pragma unroll
+        for (int j = 0; j < 4; ++j) {
+#pragma unroll
+            for (int i = 0; i < 4; ++i) acc[j][i] = 0.0F;
+        }
+    }
+    K8V4_ROWSPLIT_STAMP(7);
+}
