+    __syncthreads();
+
+    // coef_ij = beta_i exp(G_i - G_j) k_i . k_j over strict ancestors j; readout_ij = exp(G_i - G_j)
+    // q_i . k_j over the root path (j == i included), both on normalized columns.
+    for (int entry = thread; entry < kW * kW; entry += kThreads) {
+        const int i = entry / kW;
+        const int j = entry % kW;
