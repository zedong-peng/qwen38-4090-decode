+++ b/bench/ops/gdn_chunked_bench.cu
@@ -0,0 +1,156 @@
+// Staged vs chunked GDN verify record (NINFER_GDN_CHUNKED_RECORD): output agreement, record identity and
+// latency for the 27B geometry (48 value heads, 16 key heads), one row, width 16, verify tree and chain.
+// Inputs are random but in the deployed range: unit-variance q/k/v, log gates in [-1.2, -0.02], beta in
+// [0.05, 0.95], state entries N(0, 0.05).
+// usage: ninfer_gdn_chunked_bench [REPEAT]
+
+#include "ninfer/ops/gated_delta_net.h"
+
+#include <cuda_bf16.h>
+#include <cuda_runtime.h>
+
+#include <algorithm>
+#include <cmath>
+#include <cstdint>
+#include <cstdio>
+#include <cstdlib>
+#include <cstring>
+#include <random>
+#include <vector>
+
+using namespace ninfer;
+
+namespace {
+
+constexpr int kDim = 128, kQk = 16, kHv = 48, kWidth = 16, kSlots = 2;
+
+#define CK(x)                                                                                    \
+    do {                                                                                         \
+        cudaError_t e_ = (x);                                                                    \
+        if (e_ != cudaSuccess) {                                                                 \
+            std::fprintf(stderr, "%s:%d %s\n", __FILE__, __LINE__, cudaGetErrorString(e_));      \
+            std::exit(1);                                                                        \
+        }                                                                                        \
+    } while (0)
+
+template <class T>
+T* upload(const std::vector<T>& h) {
+    T* d = nullptr;
+    CK(cudaMalloc(&d, h.size() * sizeof(T)));
+    CK(cudaMemcpy(d, h.data(), h.size() * sizeof(T), cudaMemcpyHostToDevice));
+    return d;
+}
+
+template <class T>
+std::vector<T> download(const T* d, std::size_t n) {
+    std::vector<T> h(n);
+    CK(cudaMemcpy(h.data(), d, n * sizeof(T), cudaMemcpyDeviceToHost));
+    return h;
+}
+
+struct Case {
+    const char* name;
+    bool tree;
+};
+
+} // namespace
+
+int main(int argc, char** argv) {
+    const int repeat = argc > 1 ? std::atoi(argv[1]) : 200;
+    std::mt19937 rng(20261003);
+    std::normal_distribution<float> normal(0.0f, 1.0f);
+    std::uniform_real_distribution<float> uni(0.0f, 1.0f);
+    const std::size_t qk_n = static_cast<std::size_t>(kDim) * kQk * kWidth;
+    const std::size_t v_n  = static_cast<std::size_t>(kDim) * kHv * kWidth;
+    const std::size_t g_n  = static_cast<std::size_t>(kHv) * kWidth;
+    const std::size_t s_n  = static_cast<std::size_t>(kDim) * kDim * kHv * kSlots;
+    std::vector<__nv_bfloat16> hq(qk_n), hk(qk_n), hv(v_n);
+    for (auto& x : hq) x = __float2bfloat16(normal(rng));
+    for (auto& x : hk) x = __float2bfloat16(normal(rng));
+    for (auto& x : hv) x = __float2bfloat16(normal(rng));
+    std::vector<float> hg(g_n), hb(g_n), hs(s_n);
+    for (auto& x : hg) x = -0.02f - 1.18f * uni(rng);
+    for (auto& x : hb) x = 0.05f + 0.9f * uni(rng);
+    for (auto& x : hs) x = 0.05f * normal(rng);
+    const std::vector<std::int32_t> tree_parents = {-1, 0, 0, 2, 3, 3, 5, 6, 6, 8, 9, 10, 10, 12, 13, 14};
+    const std::vector<std::int32_t> initial      = {1};
+
+    auto* dq = upload(hq);
+    auto* dk = upload(hk);
+    auto* dv = upload(hv);
+    auto* dg = upload(hg);
+    auto* db = upload(hb);
+    auto* ds = upload(hs);
+    auto* dp = upload(tree_parents);
+    auto* di = upload(initial);
+    __nv_bfloat16 *out[2], *krec[2], *vrec[2];
+    float* grec[2];
+    for (int m = 0; m < 2; ++m) {
+        CK(cudaMalloc(&out[m], v_n * 2));
+        CK(cudaMalloc(&krec[m], qk_n * 2));
+        CK(cudaMalloc(&vrec[m], v_n * 2));
+        CK(cudaMalloc(&grec[m], g_n * 8));
+    }
+
+    const float scale = 1.0f / std::sqrt(static_cast<float>(kDim));
+    cudaStream_t stream;
+    CK(cudaStreamCreate(&stream));
+    cudaEvent_t a, e;
+    CK(cudaEventCreate(&a));
+    CK(cudaEventCreate(&e));
+
+    for (const Case c : {Case{"tree", true}, Case{"chain", false}}) {
+        float times[2]     = {0, 0};
+        for (int m = 0; m < 2; ++m) {
+            setenv("NINFER_GDN_CHUNKED_RECORD", m == 1 ? "1" : "0", 1);
+            Tensor q(dq, DType::BF16, {kDim, kQk, kWidth, 1});
+            Tensor k(dk, DType::BF16, {kDim, kQk, kWidth, 1});
+            Tensor v(dv, DType::BF16, {kDim, kHv, kWidth, 1});
+            Tensor g(dg, DType::FP32, {kHv, kWidth, 1});
+            Tensor beta(db, DType::FP32, {kHv, kWidth, 1});
+            Tensor states(ds, DType::FP32, {kDim, kDim, kHv, kSlots});
+            Tensor init(di, DType::I32, {1});
+            Tensor kr(krec[m], DType::BF16, {kDim, kQk, kWidth, 1});
+            Tensor vr(vrec[m], DType::BF16, {kDim, kHv, kWidth, 1});
+            Tensor gr(grec[m], DType::FP32, {2, kHv, kWidth, 1});
+            Tensor o(out[m], DType::BF16, {kDim, kHv, kWidth, 1});
+            const Tensor parents = c.tree ? Tensor(dp, DType::I32, {kWidth, 1}) : Tensor{};
+            CK(cudaMemset(out[m], 0xff, v_n * 2));
+            const auto launch = [&] {
+                ops::gated_delta_net_replay_record(q, k, v, g, beta, scale, states, Tensor{}, init, kr,
+                                                   vr, gr, o, Tensor{}, parents, stream);
+            };
+            launch();
+            CK(cudaStreamSynchronize(stream));
+            for (int w = 0; w < 20; ++w) launch();
+            CK(cudaEventRecord(a, stream));
+            for (int r = 0; r < repeat; ++r) launch();
+            CK(cudaEventRecord(e, stream));
+            CK(cudaEventSynchronize(e));
+            float ms = 0;
+            CK(cudaEventElapsedTime(&ms, a, e));
+            times[m] = 1000.0f * ms / static_cast<float>(repeat);
+        }
+        const auto o0 = download(out[0], v_n), o1 = download(out[1], v_n);
+        double num = 0, den = 0, mx = 0;
+        std::size_t diff_bits = 0;
+        for (std::size_t i = 0; i < v_n; ++i) {
+            const double x0 = __bfloat162float(o0[i]), x1 = __bfloat162float(o1[i]);
+            num += (x1 - x0) * (x1 - x0);
+            den += x0 * x0;
+            mx = std::max(mx, std::fabs(x1 - x0));
+            diff_bits += std::memcmp(&o0[i], &o1[i], 2) != 0;
+        }
+        const bool krec_same =
+            std::memcmp(download(krec[0], qk_n).data(), download(krec[1], qk_n).data(), qk_n * 2) == 0;
+        const bool vrec_same =
+            std::memcmp(download(vrec[0], v_n).data(), download(vrec[1], v_n).data(), v_n * 2) == 0;
+        const bool grec_same =
+            std::memcmp(download(grec[0], g_n * 2).data(), download(grec[1], g_n * 2).data(), g_n * 8) == 0;
+        std::printf("%-5s staged %6.2f us  chunked %6.2f us (%+.1f%%)  out rel.err %.2e max|d| %.3e "
+                    "bf16 differing %zu/%zu  records k/v/g identical %d/%d/%d\n",
+                    c.name, times[0], times[1], 100.0 * (times[1] / times[0] - 1.0), std::sqrt(num / den),
+                    mx, diff_bits, v_n, krec_same, vrec_same, grec_same);
+    }
+    return 0;
+}
