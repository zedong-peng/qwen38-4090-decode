+    }
+    __syncthreads();
+
+    if (thread < kW) {
+        key_scale[thread]   = rsqrtf(kk[thread][thread] + kQkL2NormEps);
+        query_scale[thread] = rsqrtf(qq[thread] + kQkL2NormEps);
