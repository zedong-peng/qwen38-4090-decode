+            const std::int32_t* parents =
+                Tree ? access.tree_parents + static_cast<std::int64_t>(coord.batch) * access.width
+                     : nullptr;
+            std::uint32_t mask = 0;
+            float gate_sum     = __uint_as_float(gate_raw[column].x);
+            int parent         = Tree ? parents[column] : column - 1;
+            while (parent >= 0) {
+                mask |= 1U << parent;
+                gate_sum += __uint_as_float(gate_raw[parent].x);
+                parent = Tree ? parents[parent] : parent - 1;
+            }
+            ancestors[column] = mask;
+            cum_gate[column]  = gate_sum;
