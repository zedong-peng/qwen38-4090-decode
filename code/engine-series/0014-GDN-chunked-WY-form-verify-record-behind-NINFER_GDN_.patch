+// Chunked (WY-form) record for verify trees and short chains (research path, NINFER_GDN_CHUNKED_RECORD=1).
+//
+// The staged kernel walks the columns in order and needs two warp reductions per column on the critical
+// path. A record only has to produce each column's output; the state itself is committed later by the
+// fold from the raw records this kernel writes exactly as the staged kernel does. Unrolling the gated
+// delta rule along a column's root path (A_i = exp(G_i), G_i = g_i + G_parent, k and q L2-normalized):
+//   s_i   = A_i s_0 + sum_{j in path(i)} exp(G_i - G_j) delta_j k_j^T
+//   delta_i + beta_i sum_{j in anc(i)} exp(G_i - G_j) (k_i . k_j) delta_j = beta_i (v_i - A_i s_0 . k_i)
+//   o_i   = scale (A_i s_0 . q_i + sum_{j in path(i)} exp(G_i - G_j) (q_i . k_j) delta_j)
+// A CTA forms s_0 . k_i and s_0 . q_i for its 16 state rows and the column Gram matrices on tensor cores
+// (bf16 operands; the FP32 state enters as a bf16 hi + lo split), then one 16-step forward substitution per
+// state row (ancestors precede descendants in DFS pre-order, so the system is lower triangular). Same grid,
+// access and record side effects as the staged kernel; outputs agree to FP32 rounding, not bit for bit.
+template <bool Masked, bool Tree>
+__global__ void __launch_bounds__(kWarpSize* kNumWarps, 3)
+    recurrent_record_chunked_kernel(RecordAccess<Masked> access) {
+    const RecurrentCoordinates coord = access.coordinates();
+    const std::int32_t valid         = access.active_columns(coord);
+    const int thread                 = coord.warp * kWarpSize + coord.lane;
+    constexpr int kThreads           = kWarpSize * kNumWarps;
+    constexpr int kPacksPerColumn    = kStateDim / 8;
+    constexpr int kW                 = kStagedRecordMaxWidth;
+    constexpr int kRowStride         = kStateDim + 8;  // bf16: 272-byte rows
+    constexpr int kStateStride       = kStateDim + 4;  // fp32: 528-byte rows
+    static_assert(kThreads == 128 && kW == 16 && kBlockDv == 16);
+
+    __shared__ __align__(16) __nv_bfloat16 key_raw[kW][kRowStride];
+    __shared__ __align__(16) __nv_bfloat16 query_raw[kW][kRowStride];
+    __shared__ __align__(16) float state_tile[kBlockDv][kStateStride];
+    __shared__ __align__(16) __nv_bfloat16 value_raw[kW][kBlockDv];
+    __shared__ __align__(8) uint2 gate_raw[kW];
+    __shared__ float key_scale[kW];
+    __shared__ float query_scale[kW];
+    __shared__ float cum_gate[kW];
+    __shared__ std::uint32_t ancestors[kW];
+    __shared__ float kk[kW][kW + 1];
+    __shared__ float qk[kW][kW + 1];
+    __shared__ float qq[kW];
+    __shared__ float proj_k[kBlockDv][kW + 1];
+    __shared__ float proj_q[kBlockDv][kW + 1];
+    __shared__ float coef[kW][kW + 1];
+    __shared__ float readout[kW][kW + 1];
+    __shared__ float delta_s[kBlockDv][kW + 1];
+
+    const std::uint32_t tile_dv = static_cast<std::uint32_t>(coord.state_tile * kBlockDv);
+    {
+        const float* state_base = access.state_read_base(coord) + static_cast<std::int64_t>(tile_dv) * kStateDim;
+        for (int task = thread; task < kBlockDv * (kStateDim / 4); task += kThreads) {
+            const int row = task / (kStateDim / 4);
+            const int c4  = task - row * (kStateDim / 4);
+            cp_async<16>(&state_tile[row][c4 * 4], state_base + static_cast<std::int64_t>(row) * kStateDim + c4 * 4);
+        }
+    }
+    for (int task = thread; task < valid * kPacksPerColumn; task += kThreads) {
+        const int token = task / kPacksPerColumn;
+        const int pack  = task - token * kPacksPerColumn;
+        cp_async<16>(&key_raw[token][pack * 8], access.key_ptr(coord, token) + pack * 8);
+        cp_async<16>(&query_raw[token][pack * 8], access.query_ptr(coord, token) + pack * 8);
+    }
+    for (int task = thread; task < valid * (kBlockDv / 8); task += kThreads) {
+        const int token = task / (kBlockDv / 8);
+        const int pack  = task - token * (kBlockDv / 8);
+        cp_async<16>(&value_raw[token][pack * 8],
+                     access.value_ptr(coord, token) + tile_dv + pack * 8);
+    }
+    for (int token = thread; token < valid; token += kThreads) {
+        const std::int64_t offset =
+            access.column(coord, token) * access.heads.H_v + coord.value_head;
+        cp_async<4>(&gate_raw[token].x, access.g + offset);
+        cp_async<4>(&gate_raw[token].y, access.beta + offset);
+    }
+    cp_commit();
+    // Unused column slots read as zeros, so the blocked loops below need no column guards.
+    for (int task = thread; task < (kW - valid) * kPacksPerColumn; task += kThreads) {
+        const int token = valid + task / kPacksPerColumn;
+        const int pack  = task % kPacksPerColumn;
+        store_vec(&key_raw[token][pack * 8], make_uint4(0, 0, 0, 0));
+        store_vec(&query_raw[token][pack * 8], make_uint4(0, 0, 0, 0));
+        if (pack < kBlockDv / 8) { store_vec(&value_raw[token][pack * 8], make_uint4(0, 0, 0, 0)); }
+        if (pack == 0) { gate_raw[token] = make_uint2(0U, 0U); }
+    }
+    cp_wait<0>();
+    __syncthreads();
+
+    // Records: the raw inputs, exactly as the staged kernel writes them.
+    if (coord.state_tile == 0 &&
+        static_cast<int>(coord.value_head) % access.heads.group_size() == 0) {
+        for (int task = thread; task < valid * kPacksPerColumn; task += kThreads) {
+            const int token = task / kPacksPerColumn;
+            const int pack  = task - token * kPacksPerColumn;
+            __nv_bfloat16* destination =
+                access.key_record +
+                (access.column(coord, token) * access.heads.H_qk + coord.qk_head) * kStateDim;
+            store_vec(destination + pack * 8, load_vec<uint4>(&key_raw[token][pack * 8]));
+        }
+    }
+    for (int task = thread; task < valid * (kBlockDv / 8); task += kThreads) {
+        const int token = task / (kBlockDv / 8);
+        const int pack  = task - token * (kBlockDv / 8);
+        __nv_bfloat16* destination =
+            access.value_record +
+            (access.column(coord, token) * access.heads.H_v + coord.value_head) * kStateDim;
+        store_vec(destination + tile_dv + pack * 8, load_vec<uint4>(&value_raw[token][pack * 8]));
+    }
+    if (coord.state_tile == 0) {
+        for (int token = thread; token < valid; token += kThreads) {
+            access.gate_record[access.column(coord, token) * access.heads.H_v + coord.value_head] =
+                gate_raw[token];
+        }
+    }
+    if (access.next_states != nullptr) {
+        constexpr int kLinesPerRow = kStateDim * static_cast<int>(sizeof(float)) / 128;
+        if (thread < kBlockDv * kLinesPerRow) {
+            const float* next_tile =
+                access.next_states +
+                static_cast<std::int64_t>(access.initial_slots[coord.batch]) *
+                    access.state_slot_stride +
+                static_cast<std::int64_t>(coord.value_head) * kStateDim * kStateDim;
+            prefetch_l2(next_tile +
+                        static_cast<std::int64_t>(tile_dv + thread / kLinesPerRow) * kStateDim +
+                        thread % kLinesPerRow * (128 / sizeof(float)));
+        }
+    }
+
+    // Tensor-core phase. Warp 0: Gram K K^T, Q K^T, Q Q^T (bf16 operands are exact, FP32 accumulate).
+    // Warps 1, 2: s_0 . k and s_0 . q with the FP32 state split as bf16 hi + lo (two passes, ~16-bit
+    // mantissa). Warp 3: root paths (strict-ancestor masks and cumulative log gates).
+    {
+        const int g = coord.lane >> 2;
+        const int q = coord.lane & 3;
+        const auto pair_at = [](const __nv_bfloat16* row, int col) {
+            return *reinterpret_cast<const unsigned*>(row + col);
+        };
+        if (coord.warp == 0) {
+            float d[3][2][4] = {};
+#pragma unroll
+            for (int ks = 0; ks < kStateDim / 16; ++ks) {
+                const int c = ks * 16 + 2 * q;
+                const unsigned ka[4] = {pair_at(key_raw[g], c), pair_at(key_raw[g + 8], c),
+                                        pair_at(key_raw[g], c + 8), pair_at(key_raw[g + 8], c + 8)};
+                const unsigned qa[4] = {pair_at(query_raw[g], c), pair_at(query_raw[g + 8], c),
+                                        pair_at(query_raw[g], c + 8), pair_at(query_raw[g + 8], c + 8)};
+#pragma unroll
+                for (int nt = 0; nt < 2; ++nt) {
+                    const unsigned kb0 = pair_at(key_raw[nt * 8 + g], c);
+                    const unsigned kb1 = pair_at(key_raw[nt * 8 + g], c + 8);
+                    const unsigned qb0 = pair_at(query_raw[nt * 8 + g], c);
+                    const unsigned qb1 = pair_at(query_raw[nt * 8 + g], c + 8);
+                    mma_bf16(d[0][nt][0], d[0][nt][1], d[0][nt][2], d[0][nt][3], ka[0], ka[1], ka[2], ka[3], kb0, kb1);
+                    mma_bf16(d[1][nt][0], d[1][nt][1], d[1][nt][2], d[1][nt][3], qa[0], qa[1], qa[2], qa[3], kb0, kb1);
+                    mma_bf16(d[2][nt][0], d[2][nt][1], d[2][nt][2], d[2][nt][3], qa[0], qa[1], qa[2], qa[3], qb0, qb1);
+                }
+            }
+#pragma unroll
+            for (int nt = 0; nt < 2; ++nt) {
+                const int col = nt * 8 + 2 * q;
+                kk[g][col] = d[0][nt][0];     kk[g][col + 1] = d[0][nt][1];
+                kk[g + 8][col] = d[0][nt][2]; kk[g + 8][col + 1] = d[0][nt][3];
+                qk[g][col] = d[1][nt][0];     qk[g][col + 1] = d[1][nt][1];
+                qk[g + 8][col] = d[1][nt][2]; qk[g + 8][col + 1] = d[1][nt][3];
+                if (col == g) { qq[g] = d[2][nt][0]; }
+                if (col + 1 == g) { qq[g] = d[2][nt][1]; }
+                if (col == g + 8) { qq[g + 8] = d[2][nt][2]; }
+                if (col + 1 == g + 8) { qq[g + 8] = d[2][nt][3]; }
+            }
+        } else if (coord.warp <= 2) {
