diff --git a/include/ninfer/ops/norm_handoff.h b/include/ninfer/ops/norm_handoff.h
new file mode 100644
index 0000000..703397a
--- /dev/null
+++ b/include/ninfer/ops/norm_handoff.h
@@ -0,0 +1,45 @@
+#pragma once
+
+// ninfer::ops - research35 (NINFER_NORM_HANDOFF=1): a verify RMSNorm folded into the GEMMs around it.
+//
+// The model arms a handoff (residual, norm weight, eps) before the GEMM that adds into the residual. linear_add
+// ends every armed handoff; its Q4 Ada small-T route publishes it, writing xs = bf16(x * (1 + w)) beside the
+// residual and the per-token sums of x^2 into a site slot. The norm's caller takes the published handoff instead
+// of running the norm, hands it to the next Ada small-T GEMM (gemm_set) and runs that GEMM on xs; the GEMM
+// scales its dots by rsqrt(sum / d + eps).
+
+#include "core/tensor.h"
+
+#include <cuda_runtime.h>
+
+#include <cstdint>
+
+namespace ninfer::ops {
+
+struct NormHandoff {
+    const void* norm              = nullptr; // BF16 [d] norm weight (unit offset)
+    void* xs                      = nullptr; // BF16 [d, T]: bf16(x * (1 + w))
+    unsigned long long* slot      = nullptr; // 16 per-token sums of x^2, fixed point 2^-16
+    unsigned long long* zero      = nullptr; // the producer's CTA 0 zeroes zero[0, 16 * zero_count)
+    std::int32_t zero_count       = 0;
+    float eps                     = 0.0F;
+    std::int32_t d                = 0;
+};
+
+// NINFER_NORM_HANDOFF=1 (read once).
+bool norm_handoff_enabled();
+// Start of a verify forward: sites count from 0 again.
+void norm_handoff_round_begin(cudaStream_t stream);
+// The next linear_add into `residual` publishes the norm (residual, norm, eps) if its route can.
+void norm_handoff_arm(const Tensor& residual, const Tensor& norm, float eps);
+// linear_add: ends the armed handoff; publishes it when it targets `residual` and route_ok.
+NormHandoff norm_handoff_publish(const Tensor& residual, std::int32_t tokens, bool route_ok);
+// The norm's caller: the published handoff for (residual, norm), once; empty otherwise.
+NormHandoff norm_handoff_take_consumer(const Tensor& residual, const Tensor& norm);
+// The next Ada small-T GEMM launcher that takes it scales its dots by the handoff's RMS factor.
+void norm_handoff_gemm_set(const NormHandoff& handoff);
+NormHandoff norm_handoff_gemm_take();
+// Throws (and clears) when the GEMM given a handoff did not take it.
+void norm_handoff_gemm_require_taken(const char* what);
+
+} // namespace ninfer::ops
