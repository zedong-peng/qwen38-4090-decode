diff --git a/src/ops/linear/norm_handoff.cu b/src/ops/linear/norm_handoff.cu
new file mode 100644
index 0000000..8ce1bfb
--- /dev/null
+++ b/src/ops/linear/norm_handoff.cu
@@ -0,0 +1,137 @@
+// research35 (NINFER_NORM_HANDOFF=1): host state and device buffers of the verify norm handoff.
+#include "ninfer/ops/norm_handoff.h"
+
+#include "core/device.h"
+
+#include <cuda_bf16.h>
+
+#include <cstdlib>
+#include <stdexcept>
+#include <string>
+
+namespace ninfer::ops {
+namespace {
+
+constexpr int kSlots  = 256;
+constexpr int kHidden = 5120;
+constexpr int kTokens = 16;
+
+__device__ unsigned long long g_norm_handoff_slots[kSlots * kTokens];
+__device__ __nv_bfloat16 g_norm_handoff_xs[kTokens * kHidden];
+
+struct State {
+    const void* armed_residual     = nullptr;
+    const void* armed_norm         = nullptr;
+    float armed_eps                = 0.0F;
+    const void* published_residual = nullptr;
+    NormHandoff published{};
+    NormHandoff gemm{};
+    int site = 0;
+};
+
+State& state() {
+    static State s;
+    return s;
+}
+
+unsigned long long* slots() {
+    static unsigned long long* const p = [] {
+        void* q = nullptr;
+        CUDA_CHECK(cudaGetSymbolAddress(&q, g_norm_handoff_slots));
+        return static_cast<unsigned long long*>(q);
+    }();
+    return p;
+}
+
+void* xs_buffer() {
+    static void* const p = [] {
+        void* q = nullptr;
+        CUDA_CHECK(cudaGetSymbolAddress(&q, g_norm_handoff_xs));
+        return q;
+    }();
+    return p;
+}
+
+} // namespace
+
+bool norm_handoff_enabled() {
+    static const bool on = [] {
+        const char* e = std::getenv("NINFER_NORM_HANDOFF");
+        return e != nullptr && e[0] == '1';
+    }();
+    return on;
+}
+
+void norm_handoff_round_begin(cudaStream_t stream) {
+    if (!norm_handoff_enabled()) { return; }
+    State& s = state();
+    // A forward with a single site leaves its slot 0 unzeroed.
+    if (s.site == 1) {
+        CUDA_CHECK(cudaMemsetAsync(slots(), 0, kTokens * sizeof(unsigned long long), stream));
+    }
+    s = State{};
+}
+
+void norm_handoff_arm(const Tensor& residual, const Tensor& norm, float eps) {
+    if (!norm_handoff_enabled()) { return; }
+    State& s         = state();
+    s.armed_residual = residual.data;
+    s.armed_norm     = norm.data;
+    s.armed_eps      = eps;
+}
+
+NormHandoff norm_handoff_publish(const Tensor& residual, std::int32_t tokens, bool route_ok) {
+    State& s         = state();
+    const bool armed = s.armed_residual != nullptr && s.armed_residual == residual.data;
+    s.armed_residual = nullptr;
+    if (!armed || !route_ok || s.site >= kSlots || residual.ne[0] != kHidden || tokens < 1 ||
+        tokens > kTokens) {
+        return {};
+    }
+    NormHandoff h;
+    h.norm = s.armed_norm;
+    h.xs   = xs_buffer();
+    h.slot = slots() + kTokens * s.site;
+    h.eps  = s.armed_eps;
+    h.d    = kHidden;
+    if (s.site == 0) {
+        h.zero       = slots() + kTokens;
+        h.zero_count = kSlots - 1;
+    } else if (s.site == 1) {
+        h.zero       = slots();
+        h.zero_count = 1;
+    }
+    ++s.site;
+    s.published          = h;
+    s.published_residual = residual.data;
+    return h;
+}
+
+NormHandoff norm_handoff_take_consumer(const Tensor& residual, const Tensor& norm) {
+    State& s = state();
+    if (s.published.slot == nullptr || s.published_residual != residual.data || s.published.norm != norm.data) {
+        return {};
+    }
+    const NormHandoff h = s.published;
+    s.published         = {};
+    return h;
+}
+
+void norm_handoff_gemm_set(const NormHandoff& handoff) { state().gemm = handoff; }
+
+NormHandoff norm_handoff_gemm_take() {
+    State& s            = state();
+    const NormHandoff h = s.gemm;
+    s.gemm              = {};
+    return h;
+}
+
+void norm_handoff_gemm_require_taken(const char* what) {
+    State& s = state();
+    if (s.gemm.slot != nullptr) {
+        s.gemm = {};
+        throw std::logic_error(std::string("norm handoff: ") + what + " did not take the Ada small-T route");
+    }
+}
+
+} // namespace ninfer::ops
