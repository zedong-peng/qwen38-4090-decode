diff --git a/src/ops/common/norm_handoff.cuh b/src/ops/common/norm_handoff.cuh
new file mode 100644
index 0000000..3e11ada
--- /dev/null
+++ b/src/ops/common/norm_handoff.cuh
@@ -0,0 +1,95 @@
+#pragma once
+
+// research35 (NINFER_NORM_HANDOFF=1): the Ada small-T epilogues of the verify norm handoff
+// (include/ninfer/ops/norm_handoff.h).
+
+#include <cuda_bf16.h>
+
+#include <cstdint>
+
+namespace ninfer::ops::detail {
+
+// Producer: the residual epilogue (same bits) plus xs = bf16(x_new * (1 + w[row])) and the CTA's per-token sum
+// of x_new^2 (rows j, j + 8, ... per lane, then a fixed xor tree) added to the site's fixed-point slots.
+struct AdaNormHandoffResidualEpilogue {
+    static constexpr bool kPairedHalves = false;
+    static constexpr bool kRowsHook     = true;
+    static constexpr int kMaxRows       = 40;
+
+    __nv_bfloat16* out;
+    std::int32_t out_ld;
+    const __nv_bfloat16* norm;
+    __nv_bfloat16* xs;
+    std::int32_t xs_ld;
+    unsigned long long* slot;
+    unsigned long long* zero;
+    std::int32_t zero_count;
+
+    __device__ static float (&squares())[kMaxRows][16] {
+        __shared__ float s[kMaxRows][16];
+        return s;
+    }
+
+    __device__ __forceinline__ void operator()(int, int, float) const {}
+
+    __device__ __forceinline__ void element(int weight_row, int row, int token, float value) const {
+        __nv_bfloat16* p        = out + static_cast<std::int64_t>(token) * out_ld + weight_row;
+        const __nv_bfloat16 sum = __float2bfloat16(value + __bfloat162float(*p));
+        *p                      = sum;
+        const float x           = __bfloat162float(sum);
+        xs[static_cast<std::int64_t>(token) * xs_ld + weight_row] =
+            __float2bfloat16_rn(x * (1.0f + __bfloat162float(norm[weight_row])));
+        squares()[row][token] = x * x;
+    }
+
+    __device__ __forceinline__ void rows_done(int block, int rows, int tokens, int tid, int threads) const {
+        __syncthreads();
+        if (tid < 128) {
+            const int token = tid >> 3;
+            const int j     = tid & 7;
+            float s         = 0.0f;
+            for (int r = j; r < rows; r += 8) { s += squares()[r][token]; }
+            s += __shfl_xor_sync(0xffffffffu, s, 1);
+            s += __shfl_xor_sync(0xffffffffu, s, 2);
+            s += __shfl_xor_sync(0xffffffffu, s, 4);
+            if (j == 0 && token < tokens) { atomicAdd(slot + token, __float2ull_rn(s * 65536.0f)); }
+        }
+        if (block == 0) {
+            for (int i = tid; i < 16 * zero_count; i += threads) { zero[i] = 0ull; }
+        }
+    }
+};
+
+// Consumer: Inner's epilogue on dots scaled by the token's rsqrt(sum / d + eps).
+template <class Inner>
+struct AdaRinvEpilogue {
+    static constexpr bool kPairedHalves = Inner::kPairedHalves;
+
+    Inner inner;
+    const unsigned long long* slot;
+    float eps;
+    float d;
+
+    __device__ static float* factors() {
+        __shared__ float f[16];
+        return f;
+    }
+
+    __device__ __forceinline__ void preload(int, int tid) const {
+        if (tid < 16) {
+            const double sum = static_cast<double>(slot[tid]) * (1.0 / 65536.0);
+            factors()[tid]   = rsqrtf(static_cast<float>(sum) / d + eps);
+        }
+    }
+
+    __device__ __forceinline__ void operator()(int row, int token, float value) const {
+        inner(row, token, value * factors()[token]);
+    }
+
+    __device__ __forceinline__ void operator()(int row, int token, float gate, float up) const {
+        const float f = factors()[token];
+        inner(row, token, gate * f, up * f);
+    }
+};
+
+} // namespace ninfer::ops::detail
