+// All-Q4 parents with optional Q3 shadow planes (NINFER_Q3_SHADOW): each parent runs as Q4, Q3 or Q3Odd.
+template <int TokenTiles, AdaWeightFormat FV, AdaWeightFormat FQ>
+void launch_dual_ada_q3(const Tensor& x, const Weight& qk_weight, const Weight& value_z_weight,
+                        Tensor& qk, Tensor& value, Tensor& z, cudaStream_t stream) {
+    if (qk_weight.padded_shape[1] != kHidden || value_z_weight.padded_shape[1] != kHidden) {
+        throw std::invalid_argument("Q4/Q3 GDN Ada dual requires padded K == hidden");
+    }
+    using SV = AdaSmallTSchedule<FV, 2, 8, TokenTiles, 8, 2>;
+    using SQ = AdaSmallTSchedule<FQ, 2, 8, TokenTiles, 8, 2>;
+    static_assert(kValueZRows % SV::kRowsPerCta == 0 && kQkRows % SQ::kRowsPerCta == 0);
+    const auto planes = [](const Weight& w, AdaWeightFormat f) {
+        const bool q3 = f != AdaWeightFormat::Q4;
+        return std::pair{static_cast<const std::uint8_t*>(q3 ? w.q3_low : w.qdata),
+                         q3 ? static_cast<const std::uint8_t*>(w.q3_high) : nullptr};
+    };
+    const auto [v_codes, v_high] = planes(value_z_weight, FV);
+    const auto [q_codes, q_high] = planes(qk_weight, FQ);
+    const GdnValueZEpilogue value_z_epilogue{
+        static_cast<__nv_bfloat16*>(value.data),
+        static_cast<std::int32_t>(value.nb[1] / sizeof(__nv_bfloat16)),
+        static_cast<__nv_bfloat16*>(z.data),
+        static_cast<std::int32_t>(z.nb[1] / sizeof(__nv_bfloat16))};
+    const GdnQkEpilogue qk_epilogue{static_cast<__nv_bfloat16*>(qk.data),
+                                    static_cast<std::int32_t>(qk.nb[1] / sizeof(__nv_bfloat16))};
+    ada_small_t_mma_dual_launch<SV, kHidden, SQ, kHidden>(
+        static_cast<const __nv_bfloat16*>(x.data),
+        static_cast<std::int32_t>(x.nb[1] / sizeof(__nv_bfloat16)), x.ne[1],
+        AdaSmallTOperand<GdnValueZEpilogue>{v_codes, v_high, ada_scales(value_z_weight),
+                                            value_z_epilogue, ada_super(value_z_weight)},
+        kValueZRows,
+        AdaSmallTOperand<GdnQkEpilogue>{q_codes, q_high, ada_scales(qk_weight), qk_epilogue,
+                                        ada_super(qk_weight)},
+        kQkRows, stream);
+    CUDA_CHECK(cudaGetLastError());
+}
+
+AdaWeightFormat shadow_format(const Weight& w) {
+    return w.q3_low == nullptr ? AdaWeightFormat::Q4
+           : w.q3_odd          ? AdaWeightFormat::Q3Odd
+                               : AdaWeightFormat::Q3;
+}
+
+template <int TokenTiles, AdaWeightFormat FV>
+void launch_dual_ada_q3_v(const Tensor& x, const Weight& qk_weight, const Weight& value_z_weight,
+                          Tensor& qk, Tensor& value, Tensor& z, cudaStream_t stream) {
+    switch (shadow_format(qk_weight)) {
+    case AdaWeightFormat::Q3:
+        return launch_dual_ada_q3<TokenTiles, FV, AdaWeightFormat::Q3>(x, qk_weight, value_z_weight,
+                                                                       qk, value, z, stream);
+    case AdaWeightFormat::Q3Odd:
+        return launch_dual_ada_q3<TokenTiles, FV, AdaWeightFormat::Q3Odd>(
+            x, qk_weight, value_z_weight, qk, value, z, stream);
+    default:
+        return launch_dual_ada_q3<TokenTiles, FV, AdaWeightFormat::Q4>(x, qk_weight, value_z_weight,
+                                                                       qk, value, z, stream);
+    }
+}
+
+template <int TokenTiles>
+void launch_dual_ada_shadow(const Tensor& x, const Weight& qk_weight, const Weight& value_z_weight,
+                            Tensor& qk, Tensor& value, Tensor& z, cudaStream_t stream) {
+    switch (shadow_format(value_z_weight)) {
+    case AdaWeightFormat::Q3:
+        return launch_dual_ada_q3_v<TokenTiles, AdaWeightFormat::Q3>(x, qk_weight, value_z_weight, qk,
+                                                                     value, z, stream);
+    case AdaWeightFormat::Q3Odd:
+        return launch_dual_ada_q3_v<TokenTiles, AdaWeightFormat::Q3Odd>(x, qk_weight, value_z_weight,
+                                                                        qk, value, z, stream);
+    default:
+        return launch_dual_ada_q3_v<TokenTiles, AdaWeightFormat::Q4>(x, qk_weight, value_z_weight, qk,
+                                                                     value, z, stream);
+    }
+}
+
 } // namespace
 
