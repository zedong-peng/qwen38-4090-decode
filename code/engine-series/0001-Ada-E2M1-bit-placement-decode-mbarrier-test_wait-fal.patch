diff --git a/src/ops/common/mbarrier.cuh b/src/ops/common/mbarrier.cuh
index 0418cf2..c1ead1d 100644
--- a/src/ops/common/mbarrier.cuh
+++ b/src/ops/common/mbarrier.cuh
@@ -14,6 +14,18 @@ __device__ __forceinline__ void cta_mbarrier_init(std::uint64_t* barrier, std::u
 }
 
 __device__ __forceinline__ void cta_mbarrier_wait(std::uint64_t* barrier, std::uint32_t phase) {
+#if defined(__CUDA_ARCH__) && __CUDA_ARCH__ < 900
+    // Ada: mbarrier.try_wait is sm_90+; test_wait.parity (sm_80+) polls without the suspend hint.
+    asm volatile("{\n"
+                 ".reg .pred done;\n"
+                 "wait_loop_%=: \n"
+                 "mbarrier.test_wait.parity.shared::cta.b64 done, [%0], %1;\n"
+                 "@!done bra wait_loop_%=;\n"
+                 "}\n"
+                 :
+                 : "r"(smem_addr(barrier)), "r"(phase)
+                 : "memory");
+#else
     constexpr std::uint32_t kSuspendTicks = 0x989680;
     asm volatile("{\n"
                  ".reg .pred done;\n"
@@ -26,6 +38,7 @@ __device__ __forceinline__ void cta_mbarrier_wait(std::uint64_t* barrier, std::u
                  :
                  : "r"(smem_addr(barrier)), "r"(phase), "r"(kSuspendTicks)
                  : "memory");
+#endif
 }
 
 __device__ __forceinline__ void cta_mbarrier_arrive(std::uint64_t* barrier) {
@@ -41,7 +54,13 @@ __device__ __forceinline__ void cta_mbarrier_arrive_expect_tx(std::uint64_t* bar
 }
 
 __device__ __forceinline__ void cta_mbarrier_fence_init() {
+#if defined(__CUDA_ARCH__) && __CUDA_ARCH__ < 900
+    // Ada has no clusters or async-proxy barrier consumers; the caller's __syncthreads() publishes
+    // the initialized barriers, and this orders the init stores before it.
+    __threadfence_block();
+#else
     asm volatile("fence.mbarrier_init.release.cluster;" : : : "memory");
+#endif
 }
 
 } // namespace ninfer::ops
