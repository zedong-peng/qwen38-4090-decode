Date: Mon, 5 Oct 2026 21:42:19 +0800
Subject: [PATCH 41/49] research30: GDN projected conv fused into the chunked
 record (NINFER_FUSED_CONV_RECORD, bit-exact, +1.0% slower, off)

---
 src/ops/gdn_input_proj/gdn_projected_conv.cu  | 38 ++++++++
 src/ops/gdn_input_proj/gdn_projected_conv.h   | 13 +++
 .../gated_delta_net/recurrent.cu              | 28 ++++++
 .../gated_delta_net/recurrent.cuh             | 89 +++++++++++++++++--
 src/ops/wrapper/gdn_input_proj.cpp            | 17 ++++
 5 files changed, 180 insertions(+), 5 deletions(-)

diff --git a/src/ops/gdn_input_proj/gdn_projected_conv.cu b/src/ops/gdn_input_proj/gdn_projected_conv.cu
index 01135aa..1b4b78d 100644
--- a/src/ops/gdn_input_proj/gdn_projected_conv.cu
+++ b/src/ops/gdn_input_proj/gdn_projected_conv.cu
@@ -10,6 +10,8 @@
 #include <cuda_bf16.h>
 
 #include <cstdint>
+#include <cstdio>
+#include <cstdlib>
 #include <stdexcept>
 
 namespace ninfer::ops::detail {
@@ -210,4 +212,40 @@ void gdn_projected_conv_record_launch(const Tensor& conv_record, const Tensor& c
              tree_parents, query, key, value, NoHistoryPublish{}, stream);
 }
 
+namespace {
+thread_local PendingRecordConv pending_record_conv;
+}
+
+bool fused_conv_record_enabled() {
+    static const bool on = [] {
+        const char* e = std::getenv("NINFER_FUSED_CONV_RECORD");
+        const bool v  = e != nullptr && std::atoi(e) == 1;
+        if (v) { std::fprintf(stderr, "NINFER_FUSED_CONV_RECORD=1: record convolution fused into the chunked record\n"); }
+        return v;
+    }();
+    return on;
+}
+
+void defer_record_conv(const PendingRecordConv& pending) {
+    if (pending_record_conv.set) {
+        throw std::logic_error("GDN record convolution deferred twice without a record launch");
+    }
+    pending_record_conv     = pending;
+    pending_record_conv.set = true;
+}
+
+PendingRecordConv take_pending_record_conv() {
+    PendingRecordConv out = pending_record_conv;
+    pending_record_conv   = PendingRecordConv{};
+    return out;
+}
+
+void run_pending_record_conv(PendingRecordConv& p) {
+    if (!p.set) { return; }
+    gdn_projected_conv_record_launch(p.conv_record, p.conv_weight, p.conv_states, p.valid_columns,
+                                     p.initial_state_slots, p.tree_parents, p.query, p.key, p.value,
+                                     p.stream);
+    p.set = false;
+}
+
 } // namespace ninfer::ops::detail
diff --git a/src/ops/gdn_input_proj/gdn_projected_conv.h b/src/ops/gdn_input_proj/gdn_projected_conv.h
index 67cdd1d..df27471 100644
--- a/src/ops/gdn_input_proj/gdn_projected_conv.h
+++ b/src/ops/gdn_input_proj/gdn_projected_conv.h
@@ -22,4 +22,17 @@ void gdn_projected_conv_record_launch(const Tensor& conv_record, const Tensor& c
                                       Tensor& query, Tensor& key, Tensor& value,
                                       cudaStream_t stream);
 
+// research30 (NINFER_FUSED_CONV_RECORD=1): a record convolution deferred to the next GDN record launch, which
+// fuses it into the chunked record kernel or else launches it first (run_pending_record_conv).
+struct PendingRecordConv {
+    bool set = false;
+    Tensor conv_record, conv_weight, conv_states, valid_columns, initial_state_slots, tree_parents;
+    Tensor query, key, value;
+    cudaStream_t stream = nullptr;
+};
+bool fused_conv_record_enabled();
+void defer_record_conv(const PendingRecordConv& pending);
+PendingRecordConv take_pending_record_conv();
+void run_pending_record_conv(PendingRecordConv& pending);
+
 } // namespace ninfer::ops::detail
