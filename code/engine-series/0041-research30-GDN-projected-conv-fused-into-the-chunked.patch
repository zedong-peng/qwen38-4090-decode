+            access.conv_key_offset + static_cast<std::int64_t>(coord.qk_head) * kStateDim + thread,
+            access.conv_value_offset + static_cast<std::int64_t>(coord.value_head) * kStateDim + tile_dv +
+                (thread & (kBlockDv - 1))};
+#pragma unroll
+        for (int i = 0; i < 3; ++i) {
+#pragma unroll
+            for (int k = 0; k < 4; ++k) { conv_w[i][k] = __bfloat162float(access.conv_weight[k * C + chan[i]]); }
+#pragma unroll
+            for (int k = 0; k < 3; ++k) { conv_h[i][k] = __bfloat162float(access.conv_state[hist + k * C + chan[i]]); }
+        }
     }
     for (int token = thread; token < valid; token += kThreads) {
         const std::int64_t offset =
@@ -1087,6 +1133,39 @@ __global__ void __launch_bounds__(kWarpSize* kNumWarps, 3)
     cp_wait<0>();
     __syncthreads();
 
+    if constexpr (FusedConv) {
+        // gdn_projected_conv_kernel's convolution, per channel column: DFS pre-order puts every ancestor before its
+        // descendants, so walking the columns backwards leaves each column's taps unconverted until it is done.
+        std::uint64_t parents = 0;
+        if constexpr (Tree) {
+            parents = gdn_pack_tree_parents(access.tree_parents + static_cast<std::int64_t>(coord.batch) * access.width,
+                                            access.width);
+        } else {
+#pragma unroll
+            for (int column = 1; column < kW; ++column) {
+                parents |= static_cast<std::uint64_t>(column - 1) << (4 * column);
+            }
+        }
+        const auto convolve = [&](auto& rows, int col, const float (&w)[4], const float (&h)[3]) {
+            const auto tap = [&](int column) { return __bfloat162float(rows[column][col]); };
+#pragma unroll 1
+            for (int token = valid - 1; token >= 0; --token) {
+                float s0, s1, s2;
+                gdn_tree_conv_taps(parents, token, h[0], h[1], h[2], tap, s0, s1, s2);
+                const float p = __bfloat162float(rows[token][col]);
+                float conv    = fmaf(w[0], s0, 0.0F);
+                conv          = fmaf(w[1], s1, conv);
+                conv          = fmaf(w[2], s2, conv);
+                conv          = fmaf(w[3], p, conv);
+                rows[token][col] = __float2bfloat16_rn(ops::silu(conv));
+            }
+        };
+        convolve(query_raw, thread, conv_w[0], conv_h[0]);
+        convolve(key_raw, thread, conv_w[1], conv_h[1]);
+        if (thread < kBlockDv) { convolve(value_raw, thread, conv_w[2], conv_h[2]); }
+        __syncthreads();
+    }
+
     // Records: the raw inputs, exactly as the staged kernel writes them.
     if (coord.state_tile == 0 &&
         static_cast<int>(coord.value_head) % access.heads.group_size() == 0) {
