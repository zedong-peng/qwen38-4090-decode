 #include <cuda_bf16.h>
 
@@ -110,6 +111,33 @@ void launch_recurrent_record_fixed(const Tensor& q, const Tensor& k, const Tenso
     // Research flag NINFER_GDN_CHUNKED_RECORD=1: the chunked (WY-form) record, read at each launch.
     const char* chunked_flag = std::getenv("NINFER_GDN_CHUNKED_RECORD");
     const bool chunked       = chunked_flag != nullptr && chunked_flag[0] == '1';
+    // research30 (NINFER_FUSED_CONV_RECORD=1): a convolution deferred by compose_record. The chunked route fuses it;
+    // any other route (or a mismatch) launches it first, as before.
+    ops::detail::PendingRecordConv conv = ops::detail::take_pending_record_conv();
+    if (conv.set) {
+        const bool fuse = chunked && q.ne[2] <= kStagedRecordMaxWidth && conv.stream == stream &&
+                          conv.conv_record.ne[0] == 10240 && conv.conv_record.ne[1] == q.ne[2] &&
+                          conv.query.data == q.data && conv.key.data == k.data && conv.value.data == v.data &&
+                          conv.tree_parents.data == tree_parents.data && q.ne[1] == 16 && v.ne[1] == 48 &&
+                          (Masked ? conv.valid_columns.data == valid_columns.data : conv.valid_columns.data == nullptr);
+        if (fuse) {
+            access.conv_in           = static_cast<const __nv_bfloat16*>(conv.conv_record.data);
+            access.conv_weight       = static_cast<const __nv_bfloat16*>(conv.conv_weight.data);
+            access.conv_state        = static_cast<const __nv_bfloat16*>(conv.conv_states.data);
+            access.conv_slots        = static_cast<const std::int32_t*>(conv.initial_state_slots.data);
+            access.conv_channels     = 10240;
+            access.conv_key_offset   = 2048;
+            access.conv_value_offset = 4096;
+            if (tree_parents.data != nullptr) {
+                recurrent_record_chunked_kernel<Masked, true, true><<<grid, block, 0, stream>>>(access);
+            } else {
+                recurrent_record_chunked_kernel<Masked, false, true><<<grid, block, 0, stream>>>(access);
+            }
+            CUDA_CHECK(cudaGetLastError());
+            return;
+        }
+        ops::detail::run_pending_record_conv(conv);
+    }
     if (tree_parents.data != nullptr) {
         if (q.ne[2] > kStagedRecordMaxWidth) {
             throw std::invalid_argument("GDN tree records support at most 16 columns");
diff --git a/src/ops/linear_attention/gated_delta_net/recurrent.cuh b/src/ops/linear_attention/gated_delta_net/recurrent.cuh
