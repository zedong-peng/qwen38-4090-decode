+template <bool Masked, bool Tree, bool FusedConv = false>
 __global__ void __launch_bounds__(kWarpSize* kNumWarps, 3)
     recurrent_record_chunked_kernel(RecordAccess<Masked> access) {
     const RecurrentCoordinates coord = access.coordinates();
