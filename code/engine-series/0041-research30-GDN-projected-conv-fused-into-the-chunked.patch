         return make_coordinates(static_cast<std::int32_t>(blockIdx.y), 0,
@@ -1010,7 +1021,9 @@ __global__ void __launch_bounds__(kWarpSize* kNumWarps, 2)
 // (bf16 operands; the FP32 state enters as a three-term bf16 split, 24-bit mantissa), then one 16-step forward substitution per
 // state row (ancestors precede descendants in DFS pre-order, so the system is lower triangular). Same grid,
 // access and record side effects as the staged kernel; outputs agree to FP32 rounding, not bit for bit.
-template <bool Masked, bool Tree>
