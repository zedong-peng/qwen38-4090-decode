+    float conv_w[3][4] = {};
+    float conv_h[3][3] = {};
+    if constexpr (FusedConv) {
+        const std::int64_t C    = access.conv_channels;
+        const std::int64_t hist = static_cast<std::int64_t>(access.conv_slots[coord.batch]) * C * 3;
+        const std::int64_t chan[3] = {
