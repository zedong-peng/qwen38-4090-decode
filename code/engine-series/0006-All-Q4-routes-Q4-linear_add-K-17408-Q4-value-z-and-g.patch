+def import_grouped(request: PrepareRequest) -> PreparedMethod:
+    """Write source-provided grouped-integer codes and FP16 scales unchanged."""
+    spec = get_format(request.target.format)
+    if not isinstance(spec, QuantFormat) or len(request.target.shape) != 2:
+        raise ValueError("import_grouped requires a grouped-integer matrix target")
+    _preflight(request, values=False)
+    n, k = request.target.shape
+    group = spec.group_size
+
+    def produce(output):
+        for begin in range(0, n, request.rows_per_chunk):
+            end = min(n, begin + request.rows_per_chunk)
+            words = request.encoded_rows(begin, end)
+            if words.format != request.target.format:
+                raise ValueError(
+                    f"{request.target.id}: source {words.format} differs from target"
+                )
+            codes = words.codes.reshape(end - begin, k // group, group)
+            if codes.dtype != torch.int8 or bool(
+                (codes < spec.qmin).any() or (codes > spec.qmax).any()
+            ):
+                raise ValueError(f"{request.target.id}: codes exceed the target range")
+            scales = words.scales.reshape(end - begin, k // group)
+            if scales.dtype != torch.float16 or not bool((scales > 0).all()):
+                raise ValueError(f"{request.target.id}: scales must be positive FP16")
+            output.write_codes(begin, codes.contiguous(), scales.contiguous())
+
+    return request.job(produce=produce)
+
+
