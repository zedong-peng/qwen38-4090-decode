+++ b/tools/convert/sources/grouped_codes.py
@@ -0,0 +1,49 @@
+"""Grouped-integer codes and FP16 group scales chosen outside the converter (e.g. GPTQ)."""
+
+from __future__ import annotations
+
+from tools.artifact.formats import QuantFormat, get_format
+from .logical import EncodedRows, LogicalSource
+from .safetensors import SafetensorsSource
+
+CODES, SCALES = ".gptq_codes", ".gptq_scales"
+
+
+def has_grouped_codes(store: SafetensorsSource, prefix: str) -> bool:
+    return store.has(prefix + CODES)
+
+
+def grouped_codes_source(
+    store: SafetensorsSource, prefix: str, shape: tuple[int, int], format: str
+) -> LogicalSource:
+    spec = get_format(format)
+    if not isinstance(spec, QuantFormat):
+        raise ValueError(f"{prefix}: grouped codes require a grouped integer format")
+    n, k = shape
+    group = spec.group_size
+    if k % group:
+        raise ValueError(f"{prefix}: grouped code import requires whole groups")
+    for suffix, expected, dtype in ((CODES, (n, k), "I8"), (SCALES, (n, k // group), "F16")):
+        info = store.describe(prefix + suffix)
+        if info.shape != expected or info.dtype != dtype:
+            raise ValueError(
+                f"{prefix}{suffix}: expected {dtype}{expected}, got {info.dtype}{info.shape}"
+            )
+
+    def encoded(begin: int, end: int) -> EncodedRows:
+        if not 0 <= begin < end <= n:
+            raise ValueError(f"{prefix}: invalid encoded rows [{begin},{end})")
+        codes = store.read_flat(prefix + CODES, begin * k, end * k).reshape(end - begin, k)
+        scales = store.read_flat(
+            prefix + SCALES, begin * (k // group), end * (k // group)
+        ).reshape(end - begin, k // group)
+        return EncodedRows(format, codes, scales)
+
+    def read(begin: int, end: int):
+        first, last = begin // k, (end + k - 1) // k
+        words = encoded(first, last)
+        values = words.codes.float().reshape(last - first, k // group, group)
+        values = values * words.scales.float()[..., None]
+        return values.reshape(-1)[begin - first * k : end - first * k]
+
+    return LogicalSource(shape, f"{store.path}:{prefix} ({format} codes)", read, encoded)
