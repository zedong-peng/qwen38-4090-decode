+Tensor state_scratch(int index, const Tensor& like) {
+    static float* const base = [] {
+        void* p = nullptr;
+        CUDA_CHECK(cudaGetSymbolAddress(&p, g_gdn_state_scratch));
+        return static_cast<float*>(p);
+    }();
+    if (index < 0 || index > 1 || like.ne[0] != kStateDim || like.ne[1] != kStateDim || like.ne[2] <= 0 ||
+        like.ne[2] > kStateScratchHeads || like.ne[3] != 1) {
+        throw std::invalid_argument("GDN FP16 state scratch: unsupported state shape");
+    }
+    return Tensor(base + static_cast<std::int64_t>(index) * kStateScratchHeads * kStateDim * kStateDim, DType::FP32,
+                  {like.ne[0], like.ne[1], like.ne[2]});
+}
+
+void convert_state(const Tensor& src, Tensor& dst, cudaStream_t stream) {
+    const std::int64_t n = static_cast<std::int64_t>(src.ne[0]) * src.ne[1] * src.ne[2] * src.ne[3];
+    const bool to_half   = dst.dtype == DType::FP16;
+    if (n != static_cast<std::int64_t>(dst.ne[0]) * dst.ne[1] * dst.ne[2] * dst.ne[3] ||
+        src.dtype != (to_half ? DType::FP32 : DType::FP16) || (!to_half && dst.dtype != DType::FP32) ||
+        !src.is_contiguous() || !dst.is_contiguous()) {
+        throw std::invalid_argument("GDN FP16 state conversion: mismatched tensors");
+    }
+    convert_state_kernel<<<static_cast<unsigned>(std::min<std::int64_t>((n + 255) / 256, 1024)), 256, 0, stream>>>(
+        src.data, dst.data, n, to_half);
+    CUDA_CHECK(cudaGetLastError());
+}
