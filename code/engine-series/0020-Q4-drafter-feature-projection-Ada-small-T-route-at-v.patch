@@ -25,5 +25,8 @@ void launch_q4_mma_r64_c96(const Tensor& x, const Weight& w, Tensor& out, cudaSt
 void launch_q4_mma_r64_c112(const Tensor& x, const Weight& w, Tensor& out, cudaStream_t stream);
 void launch_q4_mma_r64_c120(const Tensor& x, const Weight& w, Tensor& out, cudaStream_t stream);
 void launch_q4_mma_r64_c128(const Tensor& x, const Weight& w, Tensor& out, cudaStream_t stream);
+// Ada small-T Q4 route (T <= 16, BF16 output); instantiated in q4_ada_small_t.cu.
+template <int N, int K>
+void launch_q4_ada_small_t(const Tensor& x, const Weight& w, Tensor& out, cudaStream_t stream);
 
 } // namespace ninfer::ops::detail
diff --git a/src/ops/linear/q4/shapes/n5120_k25600.cu b/src/ops/linear/q4/shapes/n5120_k25600.cu
index 99a3a1b..7373463 100644
--- a/src/ops/linear/q4/shapes/n5120_k25600.cu
+++ b/src/ops/linear/q4/shapes/n5120_k25600.cu
@@ -17,9 +17,9 @@ using MmaR32C64 = Q4RowSplitMmaGemmSchedule<32, 64, 64, 16, 32, 3, 2, Q4Fragment
 // uses the dynamic 4-rows-per-CTA GEMV. Two staging buffers fit the static limit through 16 columns.
 Q4Launch select_q4_n5120_k25600(std::int32_t tokens) {
     if (tokens == 1) return launch_q4_gemv_r4_w1_direct;
-    if (tokens <= 4) return launch_q4_ksplit<5120, 25600, 4, 2>;
-    if (tokens <= 8) return launch_q4_ksplit<5120, 25600, 8, 2>;
-    if (tokens <= 16) return launch_q4_ksplit<5120, 25600, 16, 2>;
+    // Verify widths: the Ada small-T route streams the 69.6 MB at DRAM speed (the K-split route
+    // ran 219 us at 16 columns, no faster than Q8).
+    if (tokens <= 16) return launch_q4_ada_small_t<5120, 25600>;
     if (tokens <= 24) return launch_q4_ksplit<5120, 25600, 24>;
     if (tokens <= 32) return launch_q4_ksplit<5120, 25600, 32>;
     if (tokens <= 96) return launch_q4_mma<MmaR32C32>;
