diff --git a/src/ops/linear/q4/q4_ada_small_t.cu b/src/ops/linear/q4/q4_ada_small_t.cu
new file mode 100644
index 0000000..1d36a54
--- /dev/null
+++ b/src/ops/linear/q4/q4_ada_small_t.cu
@@ -0,0 +1,55 @@
+#include "ops/linear/q4/q4_launch.h"
+
+#include "core/device.h"
+#include "ops/linear/ada_small_t_mma.cuh"
+
+#include <cuda_bf16.h>
+
+#include <stdexcept>
+
+namespace ninfer::ops::detail {
+namespace {
+
+template <int N>
+struct AdaBf16Store {
+    static constexpr bool kPairedHalves = false;
+
+    __nv_bfloat16* out;
+
+    __device__ __forceinline__ void operator()(int row, int token, float value) const {
+        out[static_cast<std::int64_t>(token) * N + row] = __float2bfloat16_rn(value);
+    }
+};
+
+} // namespace
+
+// Q4 G64 row-split GEMM for T <= 16 into a contiguous BF16 [N, T] output on the Ada small-T kernel:
+// 40-row CTAs read every weight byte once (LS8 scales when the weight has them).
+template <int N, int K>
+void launch_q4_ada_small_t(const Tensor& x, const Weight& w, Tensor& out, cudaStream_t stream) {
+    const int tokens = x.ne[1];
+    if (tokens < 1 || tokens > 16 || x.ne[0] != K || x.dtype != DType::BF16 ||
+        out.dtype != DType::BF16 || out.ne[0] != N || w.layout != QuantLayout::RowSplit ||
+        w.padded_shape[1] != K) {
+        throw std::invalid_argument("q4 Ada small-T: unsupported operands");
+    }
+    const auto* xp   = static_cast<const __nv_bfloat16*>(x.data);
+    const auto* code = static_cast<const std::uint8_t*>(w.qdata);
+    const AdaBf16Store<N> epilogue{static_cast<__nv_bfloat16*>(out.data)};
+    if (tokens <= 8) {
+        using S = Q4AdaSmallTSchedule<5, 8, 1, 8, 2>;
+        static_assert(N % S::kRowsPerCta == 0);
+        ada_small_t_mma_launch<S, K>(xp, K, code, nullptr, ada_scales(w), N, tokens, epilogue,
+                                     stream, ada_super(w));
+    } else {
+        using S = Q4AdaSmallTSchedule<5, 8, 2, 8, 2>;
+        ada_small_t_mma_launch<S, K>(xp, K, code, nullptr, ada_scales(w), N, tokens, epilogue,
+                                     stream, ada_super(w));
+    }
+    CUDA_CHECK(cudaGetLastError());
+}
+
+template void launch_q4_ada_small_t<5120, 25600>(const Tensor&, const Weight&, Tensor&,
+                                                 cudaStream_t);
+
+} // namespace ninfer::ops::detail
