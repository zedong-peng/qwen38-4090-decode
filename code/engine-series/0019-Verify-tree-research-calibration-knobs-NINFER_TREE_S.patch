-// Research override: NINFER_TREE_TEMPERATURE replaces the tree temperature (default 1.5).
-float tree_inverse_temperature() {
-    static const float value = [] {
-        const char* env = std::getenv("NINFER_TREE_TEMPERATURE");
-        return env != nullptr ? 1.0F / std::strtof(env, nullptr) : kTreeInverseTemperature;
+// Research overrides (tools/patch_tree_calib.py): NINFER_TREE_TEMPERATURE replaces the tree temperature
+// (default 1.5); NINFER_TREE_STEP_TEMP / NINFER_TREE_STEP_BIAS give comma-separated per-step temperatures /
+// log-probability biases; NINFER_TREE_LOOKUP_SCALE scales the lookup chain's log-probability.
+TreeCalibration tree_calibration() {
+    static const TreeCalibration value = [] {
+        TreeCalibration c{};
+        const char* env       = std::getenv("NINFER_TREE_TEMPERATURE");
+        const float inverse   = env != nullptr ? 1.0F / std::strtof(env, nullptr) : kTreeInverseTemperature;
+        const auto parse_list = [](const char* name, float* out, bool reciprocal) {
+            const char* text = std::getenv(name);
+            for (int i = 0; text != nullptr && *text != 0 && i < kMaxSteps; ++i) {
+                char* end     = nullptr;
+                const float v = std::strtof(text, &end);
+                if (end == text) break;
+                out[i] = reciprocal ? 1.0F / v : v;
+                text   = *end == ',' ? end + 1 : end;
+            }
+        };
+        for (int i = 0; i < kMaxSteps; ++i) {
+            c.inverse_temperature[i] = inverse;
+            c.bias[i]                = 0.0F;
+        }
+        parse_list("NINFER_TREE_STEP_TEMP", c.inverse_temperature, true);
+        parse_list("NINFER_TREE_STEP_BIAS", c.bias, false);
+        const char* scale = std::getenv("NINFER_TREE_LOOKUP_SCALE");
+        c.lookup_scale    = scale != nullptr ? std::strtof(scale, nullptr) : 1.0F;
+        return c;
     }();
     return value;
 }
@@ -447,7 +479,7 @@ void candidate_selector_tree_launch(
     selector_tree_kernel<<<candidate_ids.ne[2], 32, 0, stream>>>(
         args, edge_data, static_cast<const std::int32_t*>(current_extents.data),
         static_cast<std::int32_t*>(tree_parents.data), static_cast<std::int32_t*>(tree_masks.data),
-        static_cast<std::int32_t*>(rope_positions.data), tree_inverse_temperature(),
+        static_cast<std::int32_t*>(rope_positions.data), tree_calibration(),
         static_cast<const std::int32_t*>(lookup_tokens.data),
         static_cast<const std::int32_t*>(lookup_counts.data),
         static_cast<const float*>(lookup_log_probability.data));
