+// One thread per (row, 64-wide group) of a Q8 G32 weight: absmax over the 64 dequantized values,
+// canonical FP16 scale absmax/qmax, round-to-nearest codes clamped to [-qmax, qmax], stored back as
+// Q8 codes c*m with both G32 scales s/m (m = 2^(8-bits); exact while s/m stays normal).
+__global__ void q8_fake_requant_kernel(std::int8_t* __restrict__ codes, __half* __restrict__ scales,
+                                       std::int64_t rows, int k, int bits) {
+    const std::int64_t index = static_cast<std::int64_t>(blockIdx.x) * blockDim.x + threadIdx.x;
+    const int groups         = k / 64;
+    if (index >= rows * groups) { return; }
+    const std::int64_t row = index / groups;
+    const int group        = static_cast<int>(index % groups);
+    std::int8_t* c         = codes + row * k + group * 64;
+    __half* sc             = scales + row * (k / 32) + 2 * group;
+    const float s0 = __half2float(sc[0]), s1 = __half2float(sc[1]);
+    float v[64];
+    float absmax = 0.0f;
+#pragma unroll
+    for (int i = 0; i < 64; ++i) {
+        v[i]   = static_cast<float>(c[i]) * (i < 32 ? s0 : s1);
+        absmax = fmaxf(absmax, fabsf(v[i]));
+    }
+    const int qmax = (1 << (bits - 1)) - 1;
+    const int m    = 1 << (8 - bits);
+    __half scale   = __float2half_rn(absmax / static_cast<float>(qmax));
+    if (__half2float(scale) == 0.0f && absmax > 0.0f) { scale = __ushort_as_half(1); }
+    const float s       = __half2float(scale);
+    const float inverse = s > 0.0f ? 1.0f / s : 0.0f;
+#pragma unroll
+    for (int i = 0; i < 64; ++i) {
+        const int q = max(-qmax, min(qmax, __float2int_rn(v[i] * inverse)));
+        c[i]        = static_cast<std::int8_t>(q * m);
+    }
+    const __half stored = __float2half_rn(s / static_cast<float>(m));
+    sc[0] = stored;
+    sc[1] = stored;
+}
