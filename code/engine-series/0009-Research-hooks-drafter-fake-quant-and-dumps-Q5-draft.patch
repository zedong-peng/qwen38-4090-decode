diff --git a/src/ops/linear/ls8_scales.cu b/src/ops/linear/ls8_scales.cu
new file mode 100644
index 0000000..7053d71
--- /dev/null
+++ b/src/ops/linear/ls8_scales.cu
@@ -0,0 +1,54 @@
+// Research (NINFER_LS8): 8-bit log group scales derived from a row-split G64 FP16 scale plane.
+
+#include "ninfer/ops/ls8_scales.h"
+
+#include "core/device.h"
+
+#include <cuda_fp16.h>
+
+#include <cstdint>
+#include <stdexcept>
+
+namespace ninfer::ops {
+namespace {
+
+// One warp per row: super = the row's largest FP16 group scale; j = round(-32 log2(s / super)),
+// clamped to [0, 255] (a zero scale maps to 255; its codes are zero).
+__global__ void ls8_transcode_kernel(const __half* __restrict__ scales, std::int32_t rows,
+                                     std::int32_t groups, std::uint8_t* __restrict__ out,
+                                     float* __restrict__ super) {
+    const std::int64_t row = static_cast<std::int64_t>(blockIdx.x) * (blockDim.x / 32) + threadIdx.x / 32;
+    const int lane         = threadIdx.x & 31;
+    if (row >= rows) { return; }
+    const __half* s = scales + row * groups;
+    float m         = 0.0f;
+    for (int g = lane; g < groups; g += 32) { m = fmaxf(m, __half2float(s[g])); }
+    for (int o = 16; o > 0; o >>= 1) { m = fmaxf(m, __shfl_xor_sync(0xffffffffu, m, o)); }
+    if (m <= 0.0f) { m = 1.0f; }
+    for (int g = lane; g < groups; g += 32) {
+        const float v = __half2float(s[g]);
+        int j         = 255;
+        if (v > 0.0f) { j = min(255, max(0, __float2int_rn(-32.0f * log2f(v / m)))); }
+        out[row * groups + g] = static_cast<std::uint8_t>(j);
+    }
+    if (lane == 0) { super[row] = m; }
+}
+
+} // namespace
+
+std::size_t ls8_bytes(const Weight& w) {
+    return static_cast<std::size_t>(w.n) * (w.k / 64);
+}
+
+void ls8_transcode(const Weight& w, void* bytes, float* super, cudaStream_t stream) {
+    if ((w.qtype != QType::Q4_G64_FP16 && w.qtype != QType::Q5_G64_FP16) ||
+        w.layout != QuantLayout::RowSplit || w.scale_dtype != DType::FP16 || w.k % 64 != 0) {
+        throw std::invalid_argument("ls8 transcode: requires a row-split Q4/Q5 G64 FP16 weight");
+    }
+    constexpr int kWarps = 8;
+    ls8_transcode_kernel<<<static_cast<unsigned>((w.n + kWarps - 1) / kWarps), 32 * kWarps, 0, stream>>>(
+        static_cast<const __half*>(w.scales), w.n, w.k / 64, static_cast<std::uint8_t*>(bytes), super);
+    CUDA_CHECK(cudaGetLastError());
+}
+
+} // namespace ninfer::ops
