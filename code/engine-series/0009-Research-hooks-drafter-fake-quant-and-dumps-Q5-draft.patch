diff --git a/src/ops/dynamic_grouped_conv/q5/q5_dynamic_grouped_conv_add.cu b/src/ops/dynamic_grouped_conv/q5/q5_dynamic_grouped_conv_add.cu
new file mode 100644
index 0000000..6bfad4c
--- /dev/null
+++ b/src/ops/dynamic_grouped_conv/q5/q5_dynamic_grouped_conv_add.cu
@@ -0,0 +1,89 @@
+#include "ops/dynamic_grouped_conv/q5/q5_dynamic_grouped_conv_add.h"
+
+#include "core/device.h"
+#include "ops/dynamic_grouped_conv/dynamic_grouped_conv_add_finish.h"
+#include "ops/linear/ada_small_t_mma.cuh"
+
+#include <cuda_bf16.h>
+
+#include <stdexcept>
+
+namespace ninfer::ops::detail {
+namespace {
+
+constexpr int kRows       = 5120;
+constexpr int kMaxColumns = 16;
+
+struct StoreEpilogue {
+    static constexpr bool kPairedHalves = false;
+
+    __nv_bfloat16* out;
+
+    __device__ __forceinline__ void operator()(int row, int token, float value) const {
+        out[static_cast<std::int64_t>(token) * kRows + row] = __float2bfloat16_rn(value);
+    }
+};
+
+template <int K>
+void project(const Tensor& x, const Weight& w, __nv_bfloat16* projected, int columns,
+             cudaStream_t stream) {
+    const auto* xp   = static_cast<const __nv_bfloat16*>(x.data);
+    const auto x_ld  = static_cast<std::int32_t>(x.nb[1] / sizeof(__nv_bfloat16));
+    const auto* code = static_cast<const std::uint8_t*>(w.qdata);
+    const auto* hi   = static_cast<const std::uint8_t*>(w.qhigh);
+    const auto* sc   = ada_scales(w);
+    const float* sup = ada_super(w);
+    const StoreEpilogue epilogue{projected};
+    if (columns <= 8) {
+        using S = Q5AdaSmallTSchedule<5, 8, 1, 8, 2>;
+        static_assert(kRows % S::kRowsPerCta == 0);
+        ada_small_t_mma_launch<S, K>(xp, x_ld, code, hi, sc, kRows, columns, epilogue, stream, sup);
+    } else {
+        using S = Q5AdaSmallTSchedule<5, 8, 2, 8, 2>;
+        ada_small_t_mma_launch<S, K>(xp, x_ld, code, hi, sc, kRows, columns, epilogue, stream, sup);
+    }
+    CUDA_CHECK(cudaGetLastError());
+}
+
+void check_profile(std::int32_t input_rows, std::int32_t columns) {
+    if (input_rows != 4096 && input_rows != 17408) {
+        throw std::invalid_argument("q5 linear dynamic grouped conv add: C must be 4096 or 17408");
+    }
+    if (columns < 1 || columns > kMaxColumns) {
+        throw std::invalid_argument("q5 linear dynamic grouped conv add: W*B must be <= 16");
+    }
+}
+
+} // namespace
+
+std::size_t q5_linear_dynamic_grouped_conv_add_workspace_capacity_bytes(
+    std::int32_t input_rows, std::int32_t min_width, std::int32_t max_width,
+    std::int32_t min_batch, std::int32_t max_batch) {
+    if (min_width < 2 || min_width > max_width || min_batch < 1 || min_batch > max_batch) {
+        throw std::invalid_argument("q5 linear dynamic grouped conv add workspace: invalid W/B");
+    }
+    check_profile(input_rows, max_width * max_batch);
+    return static_cast<std::size_t>(kRows) * max_width * max_batch * sizeof(__nv_bfloat16);
+}
+
+void q5_linear_dynamic_grouped_conv_add_dispatch(const Tensor& x, const Weight& weight,
+                                                 const Tensor& base_kernel,
+                                                 const Tensor& finish_delta, Tensor& residual,
+                                                 WorkspaceArena& workspace, cudaStream_t stream) {
+    const int tokens = x.ne[1] * x.ne[2];
+    check_profile(x.ne[0], tokens);
+    auto scope               = workspace.scope();
+    const DeviceSpan storage = workspace.alloc_bytes(static_cast<std::size_t>(kRows) * tokens *
+                                                     sizeof(__nv_bfloat16));
+    auto* projected = static_cast<__nv_bfloat16*>(storage.data);
+    if (x.ne[0] == 4096) {
+        project<4096>(x, weight, projected, tokens, stream);
+    } else {
+        project<17408>(x, weight, projected, tokens, stream);
+    }
+    Tensor out(storage.data, DType::BF16, {kRows, tokens});
+    dynamic_grouped_conv_add_finish_launch(out, base_kernel, finish_delta, residual, x.ne[1],
+                                           tokens, stream);
+}
+
+} // namespace ninfer::ops::detail
