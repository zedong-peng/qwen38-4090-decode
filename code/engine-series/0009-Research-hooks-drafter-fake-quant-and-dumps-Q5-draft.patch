+// Research: NINFER_DRAFT_DUMP=DIR appends a BF16 [K, columns] input (K contiguous) to DIR/NAME.bf16.
+void research_dump(const std::string& name, const Tensor& x, cudaStream_t stream) {
+    static const char* dir = std::getenv("NINFER_DRAFT_DUMP");
+    if (dir == nullptr || *dir == 0) { return; }
+    cudaStreamCaptureStatus capture = cudaStreamCaptureStatusNone;
+    CUDA_CHECK(cudaStreamIsCapturing(stream, &capture));
+    if (capture != cudaStreamCaptureStatusNone) {
+        throw std::runtime_error("NINFER_DRAFT_DUMP requires --no-cuda-graph");
+    }
+    const std::int64_t k = x.ne[0];
+    std::int64_t columns = x.ne[1];
+    if (x.dtype != DType::BF16 || x.nb[0] != 2) { throw std::runtime_error("draft dump: BF16 only"); }
+    if (x.ne[2] > 1) {
+        if (x.nb[2] != x.nb[1] * x.ne[1]) { throw std::runtime_error("draft dump: strided batch"); }
+        columns *= x.ne[2];
+    }
+    std::vector<std::uint16_t> host(static_cast<std::size_t>(k * columns));
+    CUDA_CHECK(cudaStreamSynchronize(stream));
+    CUDA_CHECK(cudaMemcpy2D(host.data(), k * 2, x.data, x.nb[1], k * 2, columns,
+                            cudaMemcpyDeviceToHost));
+    std::FILE* f = std::fopen((std::string(dir) + "/" + name + ".bf16").c_str(), "ab");
+    if (f == nullptr) { throw std::runtime_error("draft dump: cannot open " + name); }
+    std::fwrite(host.data(), 2, host.size(), f);
+    std::fclose(f);
+}
