+// Research: NINFER_LS8=1 attaches LS8 scale planes (ops::ls8_transcode) to row-split Q4/Q5 G64
+// weights. Device memory lives for the process.
+struct Ls8Pass {
+    std::size_t bytes = 0;
+    int weights       = 0;
+    void operator()(Weight& w) {
+        if ((w.qtype != QType::Q4_G64_FP16 && w.qtype != QType::Q5_G64_FP16) ||
+            w.layout != QuantLayout::RowSplit || w.scale_dtype != DType::FP16 || w.scales == nullptr ||
+            w.k % 64 != 0) {
+            return;
+        }
+        const std::size_t plane = ops::ls8_bytes(w);
+        void* memory            = nullptr;
+        CUDA_CHECK(cudaMalloc(&memory, plane + sizeof(float) * static_cast<std::size_t>(w.n) + 256));
+        auto* super = reinterpret_cast<float*>(
+            (reinterpret_cast<std::uintptr_t>(memory) + plane + 255) & ~std::uintptr_t(255));
+        ops::ls8_transcode(w, memory, super, nullptr);
+        w.scales_ls8  = memory;
+        w.scale_super = super;
+        bytes += plane + sizeof(float) * static_cast<std::size_t>(w.n);
+        ++weights;
+    }
+    void operator()(ops::ProjectionWeights& p) {
+        if (auto* single = std::get_if<ops::SingleProjectionWeight>(&p)) {
+            (*this)(single->weight);
+        } else {
+            auto& paired = std::get<ops::PairedProjectionWeights>(p);
+            (*this)(paired.first);
+            (*this)(paired.second);
+        }
+    }
+};
+
+} // namespace
