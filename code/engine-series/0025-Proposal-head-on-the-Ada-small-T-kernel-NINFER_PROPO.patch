+// Research (NINFER_PROPOSAL_ADA / Q3 shadow): the optimized head through the Ada small-T GEMM. Scores leave as the
+// K-split kernel's keyed partials (producer group = row / 16, rank = row % 16), so the merge is unchanged.
+struct AdaTopKEpilogue {
+    static constexpr bool kPairedHalves = false;
+    std::uint64_t* partial_keys;
+    const std::int32_t* row_to_global_ids;
+    std::int32_t producer_groups;
+
+    __device__ __forceinline__ void operator()(int row, int token, float value) const {
+        const std::int64_t offset =
+            (static_cast<std::int64_t>(token) * producer_groups + row / kLinearTopK) * kLinearTopK +
+            row % kLinearTopK;
+        store_u64_evict_last(partial_keys + offset, score_id_order_key(value, row_to_global_ids[row]));
+    }
+};
+
+template <AdaWeightFormat Format, int RowTiles, int Warps>
+void launch_ada(const Tensor& hidden, const Weight& head, const Tensor& row_to_global_ids,
+                const LinearTopKWorkspace& workspace, cudaStream_t stream) {
+    constexpr int kRows = 131072;
+    constexpr bool kQ3  = Format == AdaWeightFormat::Q3 || Format == AdaWeightFormat::Q3Odd;
+    const AdaTopKEpilogue epilogue{static_cast<std::uint64_t*>(workspace.partial_keys.data),
+                                   static_cast<const std::int32_t*>(row_to_global_ids.data),
+                                   workspace.producer_groups};
+    const auto* xp   = static_cast<const __nv_bfloat16*>(hidden.data);
+    const auto x_ld  = static_cast<std::int32_t>(hidden.nb[1] / sizeof(__nv_bfloat16));
+    const auto* code = static_cast<const std::uint8_t*>(kQ3 ? head.q3_low : head.qdata);
+    const auto* high = kQ3 ? static_cast<const std::uint8_t*>(head.q3_high) : nullptr;
+    if (hidden.ne[1] <= 8) {
+        using S = AdaSmallTSchedule<Format, RowTiles, Warps, 1, 8, 2>;
+        static_assert(kRows % S::kRowsPerCta == 0);
+        ada_small_t_mma_launch<S, kLinearTopKHidden>(xp, x_ld, code, high, ada_scales(head), kRows,
+                                                     hidden.ne[1], epilogue, stream, ada_super(head));
+    } else {
+        using S = AdaSmallTSchedule<Format, RowTiles, Warps, 2, 8, 2>;
+        static_assert(kRows % S::kRowsPerCta == 0);
+        ada_small_t_mma_launch<S, kLinearTopKHidden>(xp, x_ld, code, high, ada_scales(head), kRows,
+                                                     hidden.ne[1], epilogue, stream, ada_super(head));
+    }
+    CUDA_CHECK(cudaGetLastError());
+}
+
+bool proposal_ada() {
+    static const bool enabled = [] {
+        const char* e = std::getenv("NINFER_PROPOSAL_ADA");
+        return e != nullptr && std::atoi(e) == 1;
+    }();
+    return enabled;
+}
+
