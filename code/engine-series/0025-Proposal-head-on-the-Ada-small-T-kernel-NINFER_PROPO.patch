+def grouped_absmax_odd3(request: PrepareRequest) -> PreparedMethod:
+    """Research: the 3-bit half grid inside a Q4 G64 target, as odd codes d in [-7, 7] with an FP16 scale s
+    (levels d * s); per group the clip in {1, .95, .9, .85, .8} of s = clip * absmax / 7 with the least squared
+    error. The engine's NINFER_Q3_SHADOW repacks such a matrix into Q3 planes."""
+    if request.target.format != "q4_g64_fp16" or len(request.target.shape) != 2:
+        raise ValueError("grouped_absmax_odd3 requires a q4_g64_fp16 matrix target")
+    _preflight(request)
+    n, k = request.target.shape
+    if k % 64:
+        raise ValueError("grouped_absmax_odd3 requires K % 64 == 0")
+
+    def produce(output):
+        for begin in range(0, n, request.rows_per_chunk):
+            end = min(n, begin + request.rows_per_chunk)
+            values = request.values(begin * k, end * k).reshape(end - begin, k)
+            g = values.to(device=request.device, dtype=torch.float32).reshape(end - begin, k // 64, 64)
+            amax = g.abs().amax(-1)
+            best = None
+            for alpha in (1.0, 0.95, 0.9, 0.85, 0.8):
+                s = (amax * alpha / 7).half().float()
+                s = torch.where((s == 0) & (amax > 0), torch.full_like(s, 2.0 ** -24), s)
+                r = torch.where(s > 0, 1.0 / s, torch.zeros_like(s))
+                d = torch.clamp(2 * torch.floor(g * r[..., None] / 2) + 1, -7, 7)
+                err = ((d * s[..., None] - g) ** 2).sum(-1)
+                if best is None:
+                    best = [err, d, s]
+                else:
+                    m = err < best[0]
+                    best = [torch.where(m, err, best[0]), torch.where(m[..., None], d, best[1]),
+                            torch.where(m, s, best[2])]
+            output.write_codes(begin, best[1].to(torch.int8), best[2].half())
+
+    return request.job(produce=produce)
+
